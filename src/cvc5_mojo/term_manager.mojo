    def mkBitVector(self, size: Int, s: String, base: Int) raises -> Term:
        """Create bit-vector value.

        Supports the following arguments:

        - `Term mkBitVector(int size, int val=0)`
        - `Term mkBitVector(int size, string val, int base)`

        Returns:
            A Term representing a bit-vector value.
        """
        var api = self._o[].api
        var s_c = c_bytes(s)
        var result = api[].cvc5_mk_bv(self._handle(), to_c_uint32(size), s_c.unsafe_ptr(), to_c_uint32(base))
        return Term._received(api, self._o[].tm, result)

