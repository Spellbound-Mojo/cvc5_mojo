    def mkNullableLift(self, kind: Kind, *args: Term) raises -> Term:
        """Create a term that lifts kind to nullable terms. Example: If we have the term ((_ nullable.lift +) x y), where x, y of type (Nullable Int), then kind would be ADD, and args would be [x, y]. This function would return (nullable.lift (lambda ((a Int) (b Int)) (+ a b)) x y).

        Args:
            kind: The lifted operator.
            args: The arguments of the lifted operator.

        Returns:
            A term of Kind NULLABLE_LIFT where the first child
            is a lambda expression, and the remaining children are
            the original arguments.
        """
        var api = self._o[].api
        var args_c = List[Cvc5Term](capacity=len(args))
        for x in args:
            args_c.append(x._h)
        var result = api[].cvc5_mk_nullable_lift(self._handle(), kind, UInt(len(args_c)), args_c.unsafe_ptr())
        return Term._received(api, self._o[].tm, result)

