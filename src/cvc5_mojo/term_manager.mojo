    def mkFloatingPoint(self, arg0: Int, arg1: Int, arg2: Term) raises -> Term:
        """Create a floating-point value from a bit-vector given in IEEE-754 format, or from its three IEEE-754 bit-vector value components (sign bit, exponent, significand). Arguments must be either given as (int, int, Term) or (Term, Term, Term).

        Args:
            arg0: The size of the exponent or the sign bit.
            arg1: The size of the signifcand or the bit-vector
                representing the exponent.
            arg2: The value of the floating-point constant as a
                bit-vector term or the bit-vector representing the
                significand.

        Returns:
            The floating-point value.
        """
        var api = self._o[].api
        var result = api[].cvc5_mk_fp(self._handle(), to_c_uint32(arg0), to_c_uint32(arg1), arg2._h)
        return Term._received(api, self._o[].tm, result)

