    def mkReal(self, numerator: Integer, denominator: Integer) raises -> Term:
        """Create a real constant from a numerator and an optional denominator.

        First converts the arguments to a temporary string, either
        `"<numerator>"` or `"<numerator>/<denominator>"`. This temporary
        string is forwarded to `TermManager::mkReal()` and should
        thus represent an integer, a decimal number or a fraction.

        Args:
            numerator: The numerator.
            denominator: The denominator, or `None`.

        Returns:
            A real term with literal value.
        """
        # Keep invalid/nonpositive denominators on the original error path.
        if denominator > 0 and fits_native_integer[DType.int64](numerator) and fits_native_integer[DType.int64](denominator):
            return self._native_mkReal64(Int(numerator), Int(denominator))
        return self.mkReal(String(numerator, "/", denominator))

