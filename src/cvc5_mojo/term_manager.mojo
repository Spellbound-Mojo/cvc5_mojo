    def mkString(self, s: String, useEscSequences: Optional[Bool] = None) raises -> Term:
        """Create a String constant from a `str` which may contain SMT-LIB compatible escape sequences like `\\u1234` to encode unicode characters.

        Args:
            s: The string this constant represents.
            useEscSequences: Determines whether escape sequences in `s`
                should be converted to the corresponding
                unicode character.

        Returns:
            The String constant.
        """
        var text = s if useEscSequences else escape_smt_string(s)
        var text_c = c_bytes(text)
        var escaped = useEscSequences.value() if useEscSequences else True
        var api = self._o[].api
        return Term._received(api, self._o[].tm, api[].cvc5_mk_string(self._handle(), text_c.unsafe_ptr(), escaped))

