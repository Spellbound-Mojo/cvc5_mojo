        for x in args:
            args_c.append(x._h)
        var result = api[].cvc5_mk_term(self._handle(), kind, UInt(len(args_c)), args_c.unsafe_ptr())
        return Term._received(api, self._o[].tm, result)

    def mkTerm(self, op: Op, *args: Term) raises -> Term:
        """Create a term.

        Supports the following arguments:

        - `Term mkTerm(Kind kind)`
        - `Term mkTerm(Op op)`
        - `Term mkTerm(Kind kind, *args)`
        - `Term mkTerm(Op op, *args)`

        where `*args` is a comma-separated list of terms.
        """
        var api = self._o[].api
        var args_c = List[Cvc5Term](capacity=len(args))
        for x in args:
            args_c.append(x._h)
        var result = api[].cvc5_mk_term_from_op(self._handle(), op._h, UInt(len(args_c)), args_c.unsafe_ptr())
        return Term._received(api, self._o[].tm, result)

