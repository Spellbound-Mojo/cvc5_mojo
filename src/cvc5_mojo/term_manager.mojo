        thus represent an integer, a decimal number or a fraction.

        Args:
            numerator: The numerator.

        Returns:
            A real term with literal value.
        """
        var api = self._o[].api
        var result = api[].cvc5_mk_real_int64(self._handle(), Int64(numerator))
        return Term._received(api, self._o[].tm, result)

