    def mkCardinalityConstraint(self, sort: Sort, index: Int) raises -> Term:
        """Create cardinality constraint.

        !!! warning

            This function is experimental and may change in future versions.

        Args:
            sort: Sort of the constraint.
            index: The upper bound for the cardinality of the sort.
        """
        var api = self._o[].api
        var result = api[].cvc5_mk_cardinality_constraint(self._handle(), sort._h, to_c_uint32(index))
        return Term._received(api, self._o[].tm, result)

    def mkCardinalityConstraint(self, sort: Sort, index: IntLiteral) raises -> Term:
        """Create cardinality constraint.

        !!! warning

            This function is experimental and may change in future versions.

        Args:
            sort: Sort of the constraint.
            index: The upper bound for the cardinality of the sort.
        """
        var api = self._o[].api
        var result = api[].cvc5_mk_cardinality_constraint(self._handle(), sort._h, to_c_uint32(checked_int_literal(index)))
        return Term._received(api, self._o[].tm, result)

    def mkConst(self, sort: Sort, symbol: Optional[String] = None) raises -> Term:
        """Create (first-order) constant (0-arity function symbol).

        SMT-LIB:

        ```text
        ( declare-const <symbol> <sort> )
        ( declare-fun <symbol> ( ) <sort> )
        ```

        Args:
            sort: The sort of the constant.
            symbol: The name of the constant. If None, a default symbol
                is used.

        Returns:
            The first-order constant.
        """
        var api = self._o[].api
        var symbol_c = c_bytes(symbol.value()) if symbol else List[Int8]()
        var symbol_p = symbol_c.unsafe_ptr().unsafe_origin_cast[MutUntrackedOrigin]() if symbol else null[Int8]()
        var result = api[].cvc5_mk_const(self._handle(), sort._h, symbol_p)
        _ = symbol_c^
        return Term._received(api, self._o[].tm, result)

    def mkVar(self, sort: Sort, symbol: Optional[String] = None) raises -> Term:
        """Create a bound variable to be used in a binder (i.e. a quantifier, a lambda, or a witness binder).

        Args:
            sort: The sort of the variable.
            symbol: The name of the variable.

        Returns:
            The variable.
        """
        var api = self._o[].api
        var symbol_c = c_bytes(symbol.value()) if symbol else List[Int8]()
        var symbol_p = symbol_c.unsafe_ptr().unsafe_origin_cast[MutUntrackedOrigin]() if symbol else null[Int8]()
        var result = api[].cvc5_mk_var(self._handle(), sort._h, symbol_p)
        _ = symbol_c^
        return Term._received(api, self._o[].tm, result)

    def mkDatatypeConstructorDecl(self, name: String) raises -> DatatypeConstructorDecl:
        """Create datatype constructor declaration.

        Args:
            name: The name of the constructor.

        Returns:
            The datatype constructor declaration.
        """
        var api = self._o[].api
        var name_c = c_bytes(name)
        var result = api[].cvc5_mk_dt_cons_decl(self._handle(), name_c.unsafe_ptr())
        return DatatypeConstructorDecl._received(api, self._o[].tm, result)

    def mkDatatypeDecl(self, name: String, is_codt: Bool = False) raises -> DatatypeDecl:
        """Create a datatype declaration.

        Returns:
            The datatype declaration.
        """
        var api = self._o[].api
        var name_c = c_bytes(name)
        var result = api[].cvc5_mk_dt_decl(self._handle(), name_c.unsafe_ptr(), is_codt)
        return DatatypeDecl._received(api, self._o[].tm, result)

    def mkDatatypeDecl(self, name: String, params: List[Sort], isCoDatatype: Bool = False) raises -> DatatypeDecl:
        """Create a datatype declaration.

        Returns:
            The datatype declaration.
        """
        var api = self._o[].api
        var name_c = c_bytes(name)
        var params_c = List[Cvc5Sort](capacity=len(params))
        for x in params:
            params_c.append(x._h)
        var result = api[].cvc5_mk_dt_decl_with_params(self._handle(), name_c.unsafe_ptr(), UInt(len(params_c)), params_c.unsafe_ptr(), isCoDatatype)
        return DatatypeDecl._received(api, self._o[].tm, result)


struct _TermManagerState(Movable):
    """The cvc5 `Cvc5TermManager` of a `TermManager`, shared by its copies.

    An owned object is deleted with the last copy; a borrowed one instead
    keeps the object that returned it alive.
    """

    var api: CApiPtr
    var h: Cvc5TermManager
    var owned: Bool
    var tm: Cvc5TermManager
    var keeper_solver: Optional[ArcPointer[_SolverState]]

    def __init__(out self, api: CApiPtr, h: Cvc5TermManager, owned: Bool, tm: Cvc5TermManager):
        self.api = api
        self.h = h
        self.owned = owned
        self.tm = tm
        self.keeper_solver = None

    def __deinit__(deinit self):
        if not self.owned:
            return
        try:
            self.api[].cvc5_term_manager_delete(self.h)
        except e:
            abort(String(e))
