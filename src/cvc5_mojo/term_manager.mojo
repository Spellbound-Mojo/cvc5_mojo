        Args:
            kind: The lifted operator.
            args: The arguments of the lifted operator.

        Returns:
            A term of Kind NULLABLE_LIFT where the first child
            is a lambda expression, and the remaining children are
            the original arguments.
        """
        var api = self._o[].api
        var args_c = List[Cvc5Term](capacity=len(args))
        for x in args:
            args_c.append(x._h)
        var result = api[].cvc5_mk_nullable_lift(self._handle(), kind, UInt(len(args_c)), args_c.unsafe_ptr())
        return Term._received(api, self._o[].tm, result)

    def mkOp(self, k: Kind, *args: Integer) raises -> Op:
        """Create operator.

        Supports the following arguments:

        - `Op mkOp(Kind kind)`
        - `Op mkOp(Kind kind, const string& arg)`
        - `Op mkOp(Kind kind, uint32_t arg0, ...)`
        """
        var api = self._o[].api
        var args_c = List[UInt32](capacity=len(args))
        for x in args:
            args_c.append(to_c_uint32(x))
        var result = api[].cvc5_mk_op(self._handle(), k, UInt(len(args_c)), args_c.unsafe_ptr())
        return Op._received(api, self._o[].tm, result)

