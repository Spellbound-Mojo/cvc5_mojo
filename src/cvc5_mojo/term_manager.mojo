    def mkInteger(self, val: Integer) raises -> Term:
        """Create an integer constant.

        Args:
            val: Representation of the constant: either a string or
                integer.

        Returns:
            A constant of sort Integer.
        """
        if fits_native_integer[DType.int64](val):
            return self.mkInteger(Int(val))
        return self.mkInteger(String(val))

    def mkInteger(self, val: IntLiteral) raises -> Term:
        """Create an integer constant.

        Args:
            val: Representation of the constant: either a string or
                integer.

        Returns:
            A constant of sort Integer.
        """
        # Test the exact literal before any narrowing, then reuse the typed path.
        if fits_int_literal(val):
            return self.mkInteger(Int(val))
        return self.mkInteger(Integer(val))

    def mkReal(self, numerator: String) raises -> Term:
        """Create a real constant from a numerator and an optional denominator.

        First converts the arguments to a temporary string, either
        `"<numerator>"` or `"<numerator>/<denominator>"`. This temporary
        string is forwarded to `TermManager::mkReal()` and should
        thus represent an integer, a decimal number or a fraction.

        Args:
            numerator: The numerator.

        Returns:
            A real term with literal value.
        """
        var api = self._o[].api
        var numerator_c = c_bytes(numerator)
        var result = api[].cvc5_mk_real(self._handle(), numerator_c.unsafe_ptr())
        return Term._received(api, self._o[].tm, result)

