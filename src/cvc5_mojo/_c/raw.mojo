    def _verify_version(self) raises:
        """Check the pinned release and release both bootstrap owners on failure."""
        var parent = self.cvc5_term_manager_new()
        var owner = Cvc5(null[NoneType]())
        var actual = String()
        var failure = String()
        try:
            owner = self.cvc5_new(parent)
            actual = to_string(self.cvc5_get_version(owner))
        except e:
            failure = String(e)
        if not is_null(owner.ptr):
            self.cvc5_delete(owner)
        self.cvc5_term_manager_delete(parent)
        if failure:
            raise Error(failure)
        if actual != "1.4.1":
            raise Error("cvc5_mojo: expected cvc5 1.4.1, loaded " + actual + " from " + library_path("libcvc5"))

    def _check(self) raises:
        """Raise the error the last call on this thread recorded, and clear it."""
        if self._cvc5_has_error() != 0:
            var message = String("invalid UTF-8 in cvc5 error message")
            try:
                message = to_string(self._cvc5_get_error_message())
            except:
                pass  # Even malformed native diagnostics must clear the error state.
            self._cvc5_reset_error()
            raise Error("cvc5: " + message)

