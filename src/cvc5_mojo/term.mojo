        return result

    def getSkolemIndices(self) raises -> List[Term]:
        """See cvc5's Python documentation.

        !!! note

            Asserts `isSkolem()`.

        !!! warning

            This function is experimental and may change in future versions.

        Returns:
            The skolem indices of this term. This is list of terms that
            the skolem function is indexed by. For example, the array
            diff skolem `SkolemId.ARRAY_DEQ_DIFF` is indexed by two
            arrays.
        """
        var api = self._api
        var size = UInt(0)
        var result = api[].cvc5_term_get_skolem_indices(self._h, Pointer(to=size))
        var items = List[Term](capacity=Int(size))
        for i in range(Int(size)):
            items.append(Term._received(api, self._tm, result[unsafe_offset=i]))
        return items^

    def isUninterpretedSortValue(self) raises -> Bool:
        """See cvc5's Python documentation.

        Returns:
            True iff this term is a value from an uninterpreted sort.
        """
        var api = self._api
        var result = api[].cvc5_term_is_uninterpreted_sort_value(self._h)
        return result

    def getUninterpretedSortValue(self) raises -> String:
        """See cvc5's Python documentation.

        !!! note

            Asserts `isUninterpretedSortValue()`.

        Returns:
            The representation of an uninterpreted value as a pair of
            its sort and its index.
        """
        var api = self._api
        var result = api[].cvc5_term_get_uninterpreted_sort_value(self._h)
        return to_string(result)

    def isTupleValue(self) raises -> Bool:
        """See cvc5's Python documentation.

        Returns:
            True iff this term is a tuple value.
        """
        var api = self._api
        var result = api[].cvc5_term_is_tuple_value(self._h)
        return result

    def isRoundingModeValue(self) raises -> Bool:
        """See cvc5's Python documentation.

        Returns:
            True if the term is a floating-point rounding mode
            value.
        """
        var api = self._api
        var result = api[].cvc5_term_is_rm_value(self._h)
        return result

    def getRoundingModeValue(self) raises -> RoundingMode:
        """See cvc5's Python documentation.

        !!! note

            Asserts `isRoundingModeValue()`.

        Returns:
            The floating-point rounding mode value held by the term.
        """
        var api = self._api
        var result = api[].cvc5_term_get_rm_value(self._h)
        return result

    def getTupleValue(self) raises -> List[Term]:
        """See cvc5's Python documentation.

        !!! note

            Asserts `isTupleValue()`.

        Returns:
            The representation of a tuple value as a vector of terms.
        """
        var api = self._api
        var size = UInt(0)
        var result = api[].cvc5_term_get_tuple_value(self._h, Pointer(to=size))
        var items = List[Term](capacity=Int(size))
        for i in range(Int(size)):
            items.append(Term._received(api, self._tm, result[unsafe_offset=i]))
        return items^

    def isRealValue(self) raises -> Bool:
        """See cvc5's Python documentation.

        !!! note

            A term of kind `PI` is not considered
            to be a real value.

        Returns:
            True iff this term is a rational value.
        """
        var api = self._api
        var result = api[].cvc5_term_is_real_value(self._h)
        return result

    def getRealValue(self) raises -> Rational:
        """See cvc5's Python documentation.

        !!! note

            Asserts `isRealValue()`.

        Returns:
            The representation of a rational value as a python Fraction.
        """
        var api = self._api
        if api[].cvc5_term_is_real64_value(self._h):
            var num = Int64(0)
            var den = UInt64(0)
            api[].cvc5_term_get_real64_value(self._h, Pointer(to=num), Pointer(to=den))
            return Rational(Integer(num), Integer(den))
        return Rational(to_string(api[].cvc5_term_get_real_value(self._h)))

    def isBitVectorValue(self) raises -> Bool:
        """See cvc5's Python documentation.

        Returns:
            True iff this term is a bit-vector value.
        """
        var api = self._api
        var result = api[].cvc5_term_is_bv_value(self._h)
        return result

    def getBitVectorValue(self, base: Int = 2) raises -> String:
        """See cvc5's Python documentation.

        !!! note

            Asserts `isBitVectorValue()`.

        Supported bases are 2 (bit string), 10 (decimal string) or 16
        (hexdecimal string).

        Returns:
            The representation of a bit-vector value in string
            representation.
        """
        var api = self._api
        var result = api[].cvc5_term_get_bv_value(self._h, to_c_uint32(base))
        return to_string(result)

    def getBitVectorValue(self, base: IntLiteral) raises -> String:
        """See cvc5's Python documentation.

        !!! note

            Asserts `isBitVectorValue()`.

        Supported bases are 2 (bit string), 10 (decimal string) or 16
        (hexdecimal string).

        Returns:
            The representation of a bit-vector value in string
            representation.
        """
        var api = self._api
        var result = api[].cvc5_term_get_bv_value(self._h, to_c_uint32(checked_int_literal(base)))
        return to_string(result)

    def isFiniteFieldValue(self) raises -> Bool:
        """See cvc5's Python documentation.

        Returns:
            True iff this term is a finite field value.
        """
        var api = self._api
        var result = api[].cvc5_term_is_ff_value(self._h)
        return result

    def getFiniteFieldValue(self) raises -> Integer:
        """See cvc5's Python documentation.

        !!! note

            Asserts `isFiniteFieldValue()`.

        !!! note

            Uses the integer representative of smallest absolute value.

        Returns:
            The representation of a finite field value as an integer.
        """
        var api = self._api
        var result = api[].cvc5_term_get_ff_value(self._h)
        return Integer(to_string(result))
