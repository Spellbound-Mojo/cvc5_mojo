            return to_string(result)

    def getOptionNames(self) raises -> List[String]:
        """Get all option names that can be used with `Solver.setOption()`, `Solver.getOption()` and `Solver.getOptionInfo()`.

        Returns:
            All option names.
        """
        with _CallbackCall(self._o[].callbacks):
            var api = self._o[].api
            var size = UInt(0)
            var result = api[].cvc5_get_option_names(self._handle(), Pointer(to=size))
            return to_strings(result, size)

    def getOptionInfo(self, option: String) raises -> OptionInfo:
        """Get some information about the given option. Returns the information provided by the C++ `OptionInfo` as a dictionary.

        Returns:
            Information about the given option.
        """
        with _CallbackCall(self._o[].callbacks):
            var option_c = c_bytes(option)
            var info = Cvc5OptionInfo()
            self._o[].api[].cvc5_get_option_info(self._handle(), option_c.unsafe_ptr(), Pointer(to=info))
            return OptionInfo(_info=info)

    def getUnsatAssumptions(self) raises -> List[Term]:
        """Get the set of unsat ("failed") assumptions.

        SMT-LIB:

        ```text
        ( get-unsat-assumptions )
        ```

        Requires to enable option :ref:`produce-unsat-assumptions
        <lbl-option-produce-unsat-assumptions>`.

        Returns:
            The set of unsat assumptions.
        """
        with _CallbackCall(self._o[].callbacks):
            var api = self._o[].api
            var size = UInt(0)
            var result = api[].cvc5_get_unsat_assumptions(self._handle(), Pointer(to=size))
            var items = List[Term](capacity=Int(size))
            for i in range(Int(size)):
                items.append(Term._received(api, self._o[].tm, result[unsafe_offset=i]))
            return items^

    def getUnsatCore(self) raises -> List[Term]:
        """Get the unsatisfiable core.

        SMT-LIB:

        ```text
        (get-unsat-core)
        ```

        Requires to enable option :ref:`produce-unsat-cores
        <lbl-option-produce-unsat-cores>`.

        !!! note

            In contrast to SMT-LIB, the API does not distinguish between
            named and unnamed assertions when producing an unsatisfiable
            core. Additionally, the API allows this option to be called
            after a check with assumptions. A subset of those assumptions
            may be included in the unsatisfiable core returned by this
            method.

        Returns:
            A set of terms representing the unsatisfiable core.
        """
        with _CallbackCall(self._o[].callbacks):
            var api = self._o[].api
            var size = UInt(0)
            var result = api[].cvc5_get_unsat_core(self._handle(), Pointer(to=size))
            var items = List[Term](capacity=Int(size))
            for i in range(Int(size)):
                items.append(Term._received(api, self._o[].tm, result[unsafe_offset=i]))
            return items^

    def getUnsatCoreLemmas(self) raises -> List[Term]:
        """Get the lemmas used to derive unsatisfiability.

        SMT-LIB:

        ```text
        (get-unsat-core-lemmas)
        ```

        Requires the SAT proof unsat core mode, so to enable option
        `unsat-cores-mode=sat-proof`.

        !!! warning

            This function is experimental and may change in future versions.

        Returns:
            A set of terms representing the lemmas used to derive
            unsatisfiability.
        """
        with _CallbackCall(self._o[].callbacks):
            var api = self._o[].api
            var size = UInt(0)
            var result = api[].cvc5_get_unsat_core_lemmas(self._handle(), Pointer(to=size))
            var items = List[Term](capacity=Int(size))
            for i in range(Int(size)):
                items.append(Term._received(api, self._o[].tm, result[unsafe_offset=i]))
            return items^

    def getDifficulty(self) raises -> Dict[Term, Term]:
        """Get a difficulty estimate for an asserted formula. This function is intended to be called immediately after any response to a `Solver.checkSat()` call.

        !!! warning

            This function is experimental and may change in future versions.

        Returns:
            A map from (a subset of) the input assertions to a real
            value that is an estimate of how difficult each assertion
            was to solver. Unmentioned assertions can be assumed to
            have zero difficulty.
        """
        with _CallbackCall(self._o[].callbacks):
            var api = self._o[].api
            var size = UInt(0)
            var inputs = null[Cvc5Term]()
            var values = null[Cvc5Term]()
            api[].cvc5_get_difficulty(self._handle(), Pointer(to=size), Pointer(to=inputs), Pointer(to=values))
            var items = Dict[Term, Term](capacity=Int(size))
            var received_key = 0
            var received_value = 0
            try:
                for i in range(Int(size)):
                    var key = Term._received(api, self._o[].tm, inputs[unsafe_offset=i])
                    received_key += 1
                    var value = Term._received(api, self._o[].tm, values[unsafe_offset=i])
                    received_value += 1
                    items[key^] = value^
            finally:
                for i in range(received_key, Int(size)):
                    api[].cvc5_term_release(inputs[unsafe_offset=i])
                for i in range(received_value, Int(size)):
                    api[].cvc5_term_release(values[unsafe_offset=i])
            return items^

    def getTimeoutCore(self) raises -> Tuple[Result, List[Term]]:
        """Get a timeout core, which computes a subset of the current assertions that cause a timeout. Note it does not require being proceeded by a call to checkSat.

        This function may make multiple checks for satisfiability internally,
        each limited by the timeout value given by
        `timeout-core-timeout`.

        ```text
        (get-timeout-core)
        ```

        !!! warning

            This function is experimental and may change in future versions.

        Returns:
            The result of the timeout core computation. This is a pair
            containing a result and a list of formulas. If the result is unknown
            and the reason is timeout, then the list of formulas correspond to a
            subset of the current assertions that cause a timeout in the
            specified time
            `timeout-core-timeout`.
            If the result is unsat, then the list of formulas correspond to an
            unsat core for the current assertions. Otherwise, the result is sat,
            indicating that the current assertions are satisfiable, and
            the list of formulas is empty.
        """
        with _CallbackCall(self._o[].callbacks):
            var api = self._o[].api
            var size = UInt(0)
            var result = Cvc5Result(null[NoneType]())
            var result_ = api[].cvc5_get_timeout_core(self._handle(), Pointer(to=result), Pointer(to=size))
            var items = List[Term](capacity=Int(size))
            for i in range(Int(size)):
                items.append(Term._received(api, self._o[].tm, result_[unsafe_offset=i]))
            return (Result._received(api, self._o[].tm, result, self._o), items^)

    def getTimeoutCoreAssuming(self, *assumptions: Term) raises -> Tuple[Result, List[Term]]:
        """Get a timeout core, which computes a subset of the given assumptions that cause a timeout when added to the current assertions. Note it does not require being proceeded by a call to checkSat.

        This function may make multiple checks for satisfiability internally,
        each limited by the timeout value given by
        `timeout-core-timeout`.

        ```text
        (get-timeout-core)
        ```

        !!! warning

            This function is experimental and may change in future versions.

        Args:
            assumptions: The formulas to assume.

        Returns:
            The result of the timeout core computation. This is a pair
            containing a result and a list of formulas. If the result is unknown
            and the reason is timeout, then the list of formulas correspond to a
            subset of assumptions that cause a timeout when added to the current
            assertions in the specified time
            `timeout-core-timeout`.
            If the result is unsat, then the list of formulas plus the current
            assertions correspond to an unsat core for the current assertions.
            Otherwise, the result is sat, indicating that the given assumptions plus
            the current assertions are satisfiable, and the list of formulas is empty.
        """
        with _CallbackCall(self._o[].callbacks):
            var api = self._o[].api
            var assumptions_c = List[Cvc5Term](capacity=len(assumptions))
            for x in assumptions:
                assumptions_c.append(x._h)
            var rsize = UInt(0)
            var result = Cvc5Result(null[NoneType]())
            var result_ = api[].cvc5_get_timeout_core_assuming(self._handle(), UInt(len(assumptions_c)), assumptions_c.unsafe_ptr(), Pointer(to=result), Pointer(to=rsize))
            var items = List[Term](capacity=Int(rsize))
            for i in range(Int(rsize)):
                items.append(Term._received(api, self._o[].tm, result_[unsafe_offset=i]))
            return (Result._received(api, self._o[].tm, result, self._o), items^)

    def getTimeoutCoreAssuming(self, assumptions: List[Term]) raises -> Tuple[Result, List[Term]]:
        """Get a timeout core, which computes a subset of the given assumptions that cause a timeout when added to the current assertions. Note it does not require being proceeded by a call to checkSat.

        This function may make multiple checks for satisfiability internally,
        each limited by the timeout value given by
        `timeout-core-timeout`.

        ```text
        (get-timeout-core)
        ```

        !!! warning

            This function is experimental and may change in future versions.

        Args:
            assumptions: The formulas to assume.

        Returns:
            The result of the timeout core computation. This is a pair
            containing a result and a list of formulas. If the result is unknown
            and the reason is timeout, then the list of formulas correspond to a
            subset of assumptions that cause a timeout when added to the current
            assertions in the specified time
            `timeout-core-timeout`.
            If the result is unsat, then the list of formulas plus the current
            assertions correspond to an unsat core for the current assertions.
            Otherwise, the result is sat, indicating that the given assumptions plus
            the current assertions are satisfiable, and the list of formulas is empty.
        """
        with _CallbackCall(self._o[].callbacks):
            var api = self._o[].api
            var assumptions_c = List[Cvc5Term](capacity=len(assumptions))
            for x in assumptions:
                assumptions_c.append(x._h)
            var rsize = UInt(0)
            var result = Cvc5Result(null[NoneType]())
            var result_ = api[].cvc5_get_timeout_core_assuming(self._handle(), UInt(len(assumptions_c)), assumptions_c.unsafe_ptr(), Pointer(to=result), Pointer(to=rsize))
            var items = List[Term](capacity=Int(rsize))
            for i in range(Int(rsize)):
                items.append(Term._received(api, self._o[].tm, result_[unsafe_offset=i]))
            return (Result._received(api, self._o[].tm, result, self._o), items^)

    def getValue(self, term: Term) raises -> Term:
        """Get the value of the given term or list of terms in the current model.

        SMT-LIB:

        ```text
        ( get-value ( <term>* ) )
        ```

        Returns:
            The value or list of values of the given term or list of
            terms.
        """
        with _CallbackCall(self._o[].callbacks):
            var api = self._o[].api
            var result = api[].cvc5_get_value(self._handle(), term._h)
            return Term._received(api, self._o[].tm, result)

    def getValue(self, terms: List[Term]) raises -> List[Term]:
        """Get the value of the given term or list of terms in the current model.

        SMT-LIB:

        ```text
        ( get-value ( <term>* ) )
        ```

        Returns:
            The value or list of values of the given term or list of
            terms.
        """
        with _CallbackCall(self._o[].callbacks):
            var api = self._o[].api
            var terms_c = List[Cvc5Term](capacity=len(terms))
            for x in terms:
                terms_c.append(x._h)
            var rsize = UInt(0)
            var result = api[].cvc5_get_values(self._handle(), UInt(len(terms_c)), terms_c.unsafe_ptr(), Pointer(to=rsize))
            var items = List[Term](capacity=Int(rsize))
            for i in range(Int(rsize)):
                items.append(Term._received(api, self._o[].tm, result[unsafe_offset=i]))
            return items^

    def getModelDomainElements(self, s: Sort) raises -> List[Term]:
        """Get the domain elements of uninterpreted sort s in the current model. The current model interprets s as the finite sort whose domain elements are given in the return value of this method.

        Args:
            s: The uninterpreted sort in question.

        Returns:
            The domain elements of s in the current model.
        """
        with _CallbackCall(self._o[].callbacks):
            var api = self._o[].api
            var size = UInt(0)
            var result = api[].cvc5_get_model_domain_elements(self._handle(), s._h, Pointer(to=size))
            var items = List[Term](capacity=Int(size))
            for i in range(Int(size)):
                items.append(Term._received(api, self._o[].tm, result[unsafe_offset=i]))
            return items^

    def isModelCoreSymbol(self, v: Term) raises -> Bool:
        """This returns False if the model value of free constant v was not essential for showing the satisfiability of the last call to checkSat using the current model. This function will only return false (for any v) if the model-cores option has been set.

        !!! warning

            This function is experimental and may change in future versions.

        Args:
            v: The term in question.

        Returns:
            True if v is a model core symbol.
        """
        with _CallbackCall(self._o[].callbacks):
            var api = self._o[].api
            var result = api[].cvc5_is_model_core_symbol(self._handle(), v._h)
            return result

    def getQuantifierElimination(self, term: Term) raises -> Term:
        """Do quantifier elimination.

        SMT-LIB:

        ```text
        ( get-qe <q> )
        ```

        Requires a logic that supports quantifier elimination.
        Currently, the only logics supported by quantifier elimination
        are LRA and LIA.

        !!! warning

            This function is experimental and may change in future versions.

        Returns:
            A formula `\\phi` such that, given the current set
            of formulas `A` asserted to this solver:

            - `(A \\wedge q)` `(A \\wedge \\phi)` are
            equivalent
            - `\\phi` is quantifier-free formula containing only
            free variables in `y_1...y_n`.
        """
        with _CallbackCall(self._o[].callbacks):
            var api = self._o[].api
            var result = api[].cvc5_get_quantifier_elimination(self._handle(), term._h)
            return Term._received(api, self._o[].tm, result)

    def getQuantifierEliminationDisjunct(self, term: Term) raises -> Term:
        """Do partial quantifier elimination, which can be used for incrementally computing the result of a quantifier elimination.

        SMT-LIB:

        ```text
        ( get-qe-disjunct <q> )
        ```

        Requires a logic that supports quantifier elimination.
        Currently, the only logics supported by quantifier elimination
        are LRA and LIA.

        !!! warning

            This function is experimental and may change in future versions.

        Returns:
            A formula `\\phi` such that, given the current set
            of formulas `A` asserted to this solver:

            - `(A \\wedge q \\implies A \\wedge \\phi)` if `Q`
            is `\\forall`, and
            `(A \\wedge \\phi \\implies A \\wedge q)` if
            `Q` is `\\exists`
            - `\\phi` is quantifier-free formula containing only
            free variables in `y_1...y_n`
            - If `Q` is `\\exists`, let `(A \\wedge Q_n)`
            be the formula
            `(A \\wedge \\neg (\\phi \\wedge Q_1) \\wedge ... \\wedge \\neg (\\phi \\wedge Q_n))`
            where for each `i = 1...n`, formula
            `(\\phi \\wedge Q_i)` is the result of calling
            `getQuantifierEliminationDisjunct()`
            for `q` with the set of assertions
            `(A \\wedge Q_{i-1})`.
            Similarly, if `Q` is `\\forall`, then let
            `(A \\wedge Q_n)` be
            `(A \\wedge (\\phi \\wedge Q_1) \\wedge ... \\wedge (\\phi \\wedge Q_n))`
            where `(\\phi \\wedge Q_i)` is the same as above.
            In either case, we have that `(\\phi \\wedge Q_j)`
            will eventually be true or false, for some finite `j`.
        """
        with _CallbackCall(self._o[].callbacks):
            var api = self._o[].api
            var result = api[].cvc5_get_quantifier_elimination_disjunct(self._handle(), term._h)
            return Term._received(api, self._o[].tm, result)

    def getModel(self, sorts: List[Sort], consts: List[Term]) raises -> String:
        """Get the model.

        SMT-LIB:

        ```text
        (get-model)
        ```

        Requires to enable option
        `produce-models`.

        !!! warning

            This function is experimental and may change in future versions.

        Returns:
            A string representing the model.
        """
        with _CallbackCall(self._o[].callbacks):
            var api = self._o[].api
            var sorts_c = List[Cvc5Sort](capacity=len(sorts))
            for x in sorts:
                sorts_c.append(x._h)
            var consts_c = List[Cvc5Term](capacity=len(consts))
            for x in consts:
                consts_c.append(x._h)
            var result = api[].cvc5_get_model(self._handle(), UInt(len(sorts_c)), sorts_c.unsafe_ptr(), UInt(len(consts_c)), consts_c.unsafe_ptr())
            return to_string(result)

    def getValueSepHeap(self) raises -> Term:
        """When using separation logic, obtain the term for the heap.

        !!! warning

            This function is experimental and may change in future versions.

        Returns:
            The term for the heap.
        """
        with _CallbackCall(self._o[].callbacks):
            var api = self._o[].api
            var result = api[].cvc5_get_value_sep_heap(self._handle())
            return Term._received(api, self._o[].tm, result)

    def getValueSepNil(self) raises -> Term:
        """When using separation logic, obtain the term for nil.

        !!! warning

            This function is experimental and may change in future versions.

        Returns:
            The term for nil.
        """
        with _CallbackCall(self._o[].callbacks):
            var api = self._o[].api
            var result = api[].cvc5_get_value_sep_nil(self._handle())
            return Term._received(api, self._o[].tm, result)

    def declareSepHeap(self, locType: Sort, dataType: Sort) raises:
        """When using separation logic, this sets the location sort and the datatype sort to the given ones. This function should be invoked exactly once, before any separation logic constraints are provided.

        !!! warning

            This function is experimental and may change in future versions.
        """
        with _CallbackCall(self._o[].callbacks):
            var api = self._o[].api
            api[].cvc5_declare_sep_heap(self._handle(), locType._h, dataType._h)

    def declarePool(self, symbol: String, sort: Sort, initValue: List[Term]) raises -> Term:
        """Declare a symbolic pool of terms with the given initial value.

        SMT-LIB:

        ```text
        ( declare-pool <symbol> <sort> ( <term>* ) )
        ```

        !!! warning

            This function is experimental and may change in future versions.

        Args:
            symbol: The name of the pool.
            sort: The sort of the elements of the pool.
            initValue: The initial value of the pool.
        """
        with _CallbackCall(self._o[].callbacks):
            var api = self._o[].api
            var symbol_c = c_bytes(symbol)
            var initValue_c = List[Cvc5Term](capacity=len(initValue))
            for x in initValue:
                initValue_c.append(x._h)
            var result = api[].cvc5_declare_pool(self._handle(), symbol_c.unsafe_ptr(), sort._h, UInt(len(initValue_c)), initValue_c.unsafe_ptr())
            return Term._received(api, self._o[].tm, result)

    def addPlugin[P: Plugin](self, plugin: ArcPointer[P]) raises:
        """Add plugin to this solver. Its callbacks will be called throughout the lifetime of this solver."""
        with _CallbackCall(self._o[].callbacks):
            var registration = _CallbackRegistration(_PluginState(plugin, self._o[].api, self._o[].tm, self._o[].callbacks))
            var state = registration.state.unsafe_bitcast[_PluginState[P]]()
            _wire_plugin[P](state[].table, registration.state)
            var table = Pointer(to=state[].table).unsafe_origin_cast[MutUntrackedOrigin]()
            # The native API may retain the table before reporting a registration error.
            self._o[].callbacks[].registrations.append(registration^)
            self._o[].api[].cvc5_add_plugin(self._handle(), table)

    def pop(self, nscopes: Int = 1) raises:
        """Pop `nscopes` level(s) from the assertion stack.

        SMT-LIB:

        ```text
        ( pop <numeral> )
        ```

        Args:
            nscopes: The number of levels to pop.
        """
        with _CallbackCall(self._o[].callbacks):
            var api = self._o[].api
            api[].cvc5_pop(self._handle(), to_c_uint32(nscopes))

    def pop(self, nscopes: IntLiteral) raises:
        """Pop `nscopes` level(s) from the assertion stack.

        SMT-LIB:

        ```text
        ( pop <numeral> )
        ```

        Args:
            nscopes: The number of levels to pop.
        """
        with _CallbackCall(self._o[].callbacks):
            var api = self._o[].api
            api[].cvc5_pop(self._handle(), to_c_uint32(checked_int_literal(nscopes)))

    def push(self, nscopes: Int = 1) raises:
        """Push `nscopes` level(s) to the assertion stack.

        SMT-LIB:

        ```text
        ( push <numeral> )
        ```

        Args:
            nscopes: The number of levels to push.
        """
        with _CallbackCall(self._o[].callbacks):
            var api = self._o[].api
            api[].cvc5_push(self._handle(), to_c_uint32(nscopes))

    def push(self, nscopes: IntLiteral) raises:
        """Push `nscopes` level(s) to the assertion stack.

        SMT-LIB:

        ```text
        ( push <numeral> )
        ```

        Args:
            nscopes: The number of levels to push.
        """
        with _CallbackCall(self._o[].callbacks):
            var api = self._o[].api
            api[].cvc5_push(self._handle(), to_c_uint32(checked_int_literal(nscopes)))

    def resetAssertions(self) raises:
        """Remove all assertions.

        SMT-LIB:

        ```text
        ( reset-assertions )
        ```
        """
        with _CallbackCall(self._o[].callbacks):
            var api = self._o[].api
            api[].cvc5_reset_assertions(self._handle())

    def setInfo(self, keyword: String, value: String) raises:
        """Set info.

        SMT-LIB:

        ```text
        ( set-info <attribute> )
        ```

        Args:
            keyword: The info flag.
            value: The value of the info flag.
        """
        with _CallbackCall(self._o[].callbacks):
            var api = self._o[].api
            var keyword_c = c_bytes(keyword)
            var value_c = c_bytes(value)
            api[].cvc5_set_info(self._handle(), keyword_c.unsafe_ptr(), value_c.unsafe_ptr())

    def setLogic(self, logic: String) raises:
        """Set logic.

        SMT-LIB:

        ```text
        ( set-logic <symbol> )
        ```

        Args:
            logic: The logic to set.
        """
        with _CallbackCall(self._o[].callbacks):
            var api = self._o[].api
            var logic_c = c_bytes(logic)
            api[].cvc5_set_logic(self._handle(), logic_c.unsafe_ptr())

    def isLogicSet(self) raises -> Bool:
        """Is logic set? Returns whether we called setLogic yet for this solver.

        Returns:
            Whether we called setLogic yet for this solver.
        """
        with _CallbackCall(self._o[].callbacks):
            var api = self._o[].api
            var result = api[].cvc5_is_logic_set(self._handle())
            return result

    def getLogic(self) raises -> String:
        """Get the logic set the solver.

        !!! note

            Asserts isLogicSet().

        Returns:
            The logic used by the solver.
        """
        with _CallbackCall(self._o[].callbacks):
            var api = self._o[].api
            var result = api[].cvc5_get_logic(self._handle())
            return to_string(result)

    def setOption(self, option: String, value: String) raises:
        """Set option.

        SMT-LIB:

        ```text
        ( set-option <option> )
        ```

        Args:
            option: The option name.
            value: The option value.
        """
        with _CallbackCall(self._o[].callbacks):
            var api = self._o[].api
            var option_c = c_bytes(option)
            var value_c = c_bytes(value)
            api[].cvc5_set_option(self._handle(), option_c.unsafe_ptr(), value_c.unsafe_ptr())

    def getInterpolant(self, conj: Term) raises -> Term:
        """Get an interpolant. Assuming that `A \\rightarrow B` is valid, this function determines a term `I` over the shared variables of `A` and `B`, optionally with respect to a a given grammar, such that `A \\rightarrow I` and `I \\rightarrow B` are valid, if such a term exits. `A` is the current set of assertions and `B` is the conjecture, given as `conj`.

        SMT-LIB:

        ```text
        ( get-interpolant <symbol> <conj> )
        ( get-interpolant <symbol> <conj> <grammar> )
        ```

        !!! note

            In SMT-LIB, `<symbol>` assigns a symbol to the

            interpolant.

        !!! note

            Requires option

            `produce-interpolants`
            to be set to a mode different from `none`.

        !!! warning

            This function is experimental and may change in future versions.

        Args:
            conj: The conjecture term.

        Returns:
            The interpolant, if such a term exists.
        """
        with _CallbackCall(self._o[].callbacks):
            var api = self._o[].api
            var result = api[].cvc5_get_interpolant(self._handle(), conj._h)
            return Term._received(api, self._o[].tm, result)

    def getInterpolant(self, conj: Term, grammar: Grammar) raises -> Term:
        """Get an interpolant. Assuming that `A \\rightarrow B` is valid, this function determines a term `I` over the shared variables of `A` and `B`, optionally with respect to a a given grammar, such that `A \\rightarrow I` and `I \\rightarrow B` are valid, if such a term exits. `A` is the current set of assertions and `B` is the conjecture, given as `conj`.

        SMT-LIB:

        ```text
        ( get-interpolant <symbol> <conj> )
        ( get-interpolant <symbol> <conj> <grammar> )
        ```

        !!! note

            In SMT-LIB, `<symbol>` assigns a symbol to the

            interpolant.

        !!! note

            Requires option

            `produce-interpolants`
            to be set to a mode different from `none`.

        !!! warning

            This function is experimental and may change in future versions.

        Args:
            conj: The conjecture term.
            grammar: A grammar for the interpolant.

        Returns:
            The interpolant, if such a term exists.
        """
        with _CallbackCall(self._o[].callbacks):
            var api = self._o[].api
            var result = api[].cvc5_get_interpolant_with_grammar(self._handle(), conj._h, grammar._h)
            return Term._received(api, self._o[].tm, result)

    def getInterpolantNext(self) raises -> Term:
        """Get the next interpolant.

        Can only be called immediately after a successful call to
        `Solver.getInterpolant()` or
        `Solver.getInterpolantNext()`.
        Is guaranteed to produce a syntactically different interpolant wrt
        the last returned interpolant if successful.

        SMT-LIB:

        ```text
        ( get-interpolant-next )
        ```

        Requires to enable incremental mode, and option
        `produce-interpolants` to be
        set to a mode different from `none`.

        !!! warning

            This function is experimental and may change in future versions.

        Returns:
            True iff an interpolant was found.
        """
        with _CallbackCall(self._o[].callbacks):
            var api = self._o[].api
            var result = api[].cvc5_get_interpolant_next(self._handle())
            return Term._received(api, self._o[].tm, result)

    def getAbduct(self, conj: Term) raises -> Term:
        """Get an abduct.

        SMT-LIB:

        ```text
        ( get-abduct <conj> )
        ( get-abduct <conj> <grammar> )
        ```

        Requires to enable option
        `produce-abducts`.

        !!! warning

            This function is experimental and may change in future versions.

        Args:
            conj: The conjecture term.

        Returns:
            The abduct.
            See `Solver::getAbduct` for details.
        """
        with _CallbackCall(self._o[].callbacks):
            var api = self._o[].api
            var result = api[].cvc5_get_abduct(self._handle(), conj._h)
            return Term._received(api, self._o[].tm, result)

    def getAbduct(self, conj: Term, grammar: Grammar) raises -> Term:
        """Get an abduct.

        SMT-LIB:

        ```text
        ( get-abduct <conj> )
        ( get-abduct <conj> <grammar> )
        ```

        Requires to enable option
        `produce-abducts`.

        !!! warning

            This function is experimental and may change in future versions.

        Args:
            conj: The conjecture term.
            grammar: A grammar for the abduct.

        Returns:
            The abduct.
            See `Solver::getAbduct` for details.
        """
        with _CallbackCall(self._o[].callbacks):
            var api = self._o[].api
            var result = api[].cvc5_get_abduct_with_grammar(self._handle(), conj._h, grammar._h)
            return Term._received(api, self._o[].tm, result)

    def getAbductNext(self) raises -> Term:
        """Get the next abduct.

        Can only be called immediately after a successful call to
        `Solver.getAbduct()` or
        `Solver.getAbductNext()`.
        Is guaranteed to produce a syntactically different abduct wrt the
        last returned abduct if successful.

        SMT-LIB:

        ```text
        ( get-abduct-next )
        ```

        Requires to enable incremental mode, and
        option `produce-abducts`.

        !!! warning

            This function is experimental and may change in future versions.

        Returns:
            True iff an abduct was found.
        """
        with _CallbackCall(self._o[].callbacks):
            var api = self._o[].api
            var result = api[].cvc5_get_abduct_next(self._handle())
            return Term._received(api, self._o[].tm, result)

    def blockModel(self, mode: BlockModelsMode) raises:
        """Block the current model. Can be called only if immediately preceded by a SAT or INVALID query.

        SMT-LIB:

        ```text
        (block-model)
        ```

        Requires enabling option
        `produce-models`
        to a mode other than `none`.

        !!! warning

            This function is experimental and may change in future versions.

        Args:
            mode: The mode to use for blocking.
        """
        with _CallbackCall(self._o[].callbacks):
            var api = self._o[].api
            api[].cvc5_block_model(self._handle(), mode)

    def blockModelValues(self, terms: List[Term]) raises:
        """Block the current model values of (at least) the values in terms. Can be called only if immediately preceded by a SAT query.

        SMT-LIB:

        ```text
        (block-model-values ( <terms>+ ))
        ```

        Requires enabling option
        `produce-models`.

        !!! warning

            This function is experimental and may change in future versions.
        """
        with _CallbackCall(self._o[].callbacks):
            var api = self._o[].api
            var terms_c = List[Cvc5Term](capacity=len(terms))
            for x in terms:
                terms_c.append(x._h)
            api[].cvc5_block_model_values(self._handle(), UInt(len(terms_c)), terms_c.unsafe_ptr())

    def getInstantiations(self) raises -> String:
        """Return a string that contains information about all instantiations made by the quantifiers module.

        !!! warning

            This function is experimental and may change in future versions.
        """
        with _CallbackCall(self._o[].callbacks):
            var api = self._o[].api
            var result = api[].cvc5_get_instantiations(self._handle())
            return to_string(result)

    def getStatistics(self) raises -> Statistics:
        """Return a snapshot of the current state of the statistic values of this solver. The returned object is completely decoupled from the solver and will not change when the solver is used again."""
        with _CallbackCall(self._o[].callbacks):
            var api = self._o[].api
            var result = api[].cvc5_get_statistics(self._handle())
            return Statistics._received(api, self._o[].tm, result)

    def getVersion(self) raises -> String:
        """Return a string representation of the version of this solver."""
        with _CallbackCall(self._o[].callbacks):
            var api = self._o[].api
            var result = api[].cvc5_get_version(self._handle())
            return to_string(result)

    def declareOracleFun[O: Oracle](self, symbol: String, sorts: List[Sort], sort: Sort, oracle: ArcPointer[O]) raises -> Term:
        """Declare an oracle function with reference to an implementation.

        Oracle functions have a different semantics with respect to ordinary
        declared functions. In particular, for an input to be satisfiable,
        its oracle functions are implicitly universally quantified.

        This function is used in part for implementing this command:

        ```text
        (declare-oracle-fun <sym> (<sort>*) <sort> <sym>)
        ```

        In particular, the above command is implemented by constructing a
        function over terms that wraps a call to binary sym via a text interface.

        !!! warning

            This function is experimental and may change in future versions.

        Returns:
            The oracle function.
        """
        with _CallbackCall(self._o[].callbacks):
            if sort.isNull() or sort._tm.ptr != self._o[].tm.ptr:
                raise Error("cvc5_mojo: oracle result sort must belong to this term manager")
            var handles = List[Cvc5Sort](capacity=len(sorts))
            for domain in sorts:
                if domain.isNull() or domain._tm.ptr != self._o[].tm.ptr:
                    raise Error("cvc5_mojo: oracle domain sort must belong to this term manager")
                handles.append(domain._h)
            var symbol_c = c_bytes(symbol)
            var tm = TermManager(_borrowed=self._o[].tm, _from_solver=self._o)
            # A deliberately different sort makes cvc5's checked oracle evaluator
            # unwind to the public call boundary. No fabricated result escapes.
            var sentinel = tm.mkInteger(0) if sort.isBoolean() else tm.mkTrue()
            var registration = _CallbackRegistration(_OracleState(oracle, self._o[].api, self._o[].tm, self._o[].callbacks, sort, sentinel))
            var state = registration.state
            self._o[].callbacks[].registrations.append(registration^)
            var handle = self._o[].api[].cvc5_declare_oracle_fun(self._handle(), symbol_c.unsafe_ptr(), UInt(len(handles)), handles.unsafe_ptr(), sort._h, state, _oracle_evaluate[O])
            return Term._received(self._o[].api, self._o[].tm, handle)


struct _SolverState(Movable):
    """The cvc5 `Cvc5` of a `Solver`, shared by its copies.

    An owned object is deleted with the last copy; a borrowed one instead
    keeps the object that returned it alive.
    """

    var api: CApiPtr
    var h: Cvc5
    var owned: Bool
    var tm: Cvc5TermManager
    var keeper_input_parser: Optional[ArcPointer[_InputParserState]]
    var callbacks: ArcPointer[_CallbackRegistry]

    def __init__(out self, api: CApiPtr, h: Cvc5, owned: Bool, tm: Cvc5TermManager):
        self.api = api
        self.h = h
        self.owned = owned
        self.tm = tm
        self.keeper_input_parser = None
        self.callbacks = ArcPointer(_CallbackRegistry())

    def __deinit__(deinit self):
        if not self.owned:
            return
        try:
            self.api[].cvc5_delete(self.h)
        except e:
            abort(String(e))
        _ = self.callbacks^  # Native deletion may still use the callbacks.


trait Oracle(Movable, Deinitable):
    """A deterministic implementation of an SMT oracle function.

    Retained by `Solver.declareOracleFun`. Arguments are owned terms and may
    be copied; return a non-null term of the declared sort and term manager.
    Do not call back into the registering solver or its parser. An error
    invalidates that solver and is raised after native evaluation unwinds.
    """

    def evaluate(mut self, arguments: List[Term]) raises -> Term:
        ...


struct _OracleState[O: Oracle](Movable):
    var oracle: ArcPointer[Self.O]
    var api: CApiPtr
    var tm: Cvc5TermManager
    var registry: Pointer[_CallbackRegistry, MutUntrackedOrigin]
    var sort: Sort
    var sentinel: Term
    var result: Term

    def __init__(out self, oracle: ArcPointer[Self.O], api: CApiPtr, tm: Cvc5TermManager, registry: ArcPointer[_CallbackRegistry], sort: Sort, sentinel: Term):
        self.oracle = oracle
        self.api = api
        self.tm = tm
        self.registry = Pointer(to=registry[]).unsafe_origin_cast[MutUntrackedOrigin]()
        self.sort = sort
        self.sentinel = sentinel
        self.result = sentinel


def _oracle_evaluate[O: Oracle](size: UInt, handles: Pointer[Cvc5Term, MutUntrackedOrigin], data: Ptr) abi("C") -> Ptr:
    var state = data.unsafe_bitcast[_OracleState[O]]()
    # Receive every exported argument even if another callback has failed.
    var arguments = List[Term](capacity=Int(size))
    for i in range(Int(size)):
        arguments.append(Term._received(state[].api, state[].tm, handles[unsafe_offset=i]))
    if not state[].registry[].error.byte_length():
        try:
            var result = state[].oracle[].evaluate(arguments)
            if result.isNull():
                raise Error("evaluate() must return a non-null term")
            if result._tm.ptr != state[].tm.ptr:
                raise Error("result belongs to a different term manager")
            if result.getSort() != state[].sort:
                raise Error("result does not have the declared oracle sort")
            state[].result = result^
            return state[].result._h.ptr
        except e:
            state[].registry[]._fail(String(e), "oracle")
    return state[].sentinel._h.ptr


struct OptionInfo(Copyable, Movable, Writable):
    """Information about an option, as `Solver.getOptionInfo` returns it.

    Python returns a dict whose keys depend on the option's value type; an
    `OptionInfo` has every key as a field, and a key Python leaves out for
    that type is `None`, or an empty `modes`. It prints as Python prints the
    dict.
    """

    comptime Value = Variant[Bool, String, Int, UInt64, Float64]
    """A value: `Bool`, `String` (also a mode), `Int` for int64 options,
    `UInt64` for uint64 options, or `Float64`. Python has `int` for both."""

    var name: String
    """The option's name."""
    var aliases: List[String]
    """Its other names."""
    var setByUser: Bool
    """Whether the user set it."""
    var category: OptionCategory
    """Its category."""
    var type: Optional[String]
    """Its value type as Python names it: "bool", "str", "int", "float" or
    "mode"; `None` for an option without a value."""
    var current: Optional[Self.Value]
    """The current value."""
    var default: Optional[Self.Value]
    """The default value."""
    var minimum: Optional[Self.Value]
    """The smallest value allowed, for a number with a lower bound."""
    var maximum: Optional[Self.Value]
    """The largest value allowed, for a number with an upper bound."""
    var modes: List[String]
    """The modes a mode option allows."""

    def __init__(out self, *, _info: Cvc5OptionInfo) raises:
        """Copy what cvc5 filled in, which is valid only until its next call.

        Args:
            _info: The struct cvc5 filled.
        """
        self.name = to_string(_info.name())
        self.aliases = to_strings(_info.aliases(), _info.num_aliases())
        self.setByUser = _info.is_set_by_user()
        self.category = _info.category()
        self.type = None
        self.current = None
        self.default = None
        self.minimum = None
        self.maximum = None
        self.modes = List[String]()
        var kind = _info.kind()
        if kind == Cvc5OptionInfoKind.BOOL:
            self.type = String("bool")
            self.current = Self.Value(_info.info_bool_cur())
            self.default = Self.Value(_info.info_bool_dflt())
        elif kind == Cvc5OptionInfoKind.STR:
            self.type = String("str")
            self.current = Self.Value(to_string(_info.info_str_cur()))
            self.default = Self.Value(to_string(_info.info_str_dflt()))
        elif kind == Cvc5OptionInfoKind.INT64:
            self.type = String("int")
            self.current = Self.Value(Int(_info.info_int_cur()))
            self.default = Self.Value(Int(_info.info_int_dflt()))
            if _info.info_int_has_min():
                self.minimum = Self.Value(Int(_info.info_int_min()))
            if _info.info_int_has_max():
                self.maximum = Self.Value(Int(_info.info_int_max()))
        elif kind == Cvc5OptionInfoKind.UINT64:
            self.type = String("int")
            self.current = Self.Value(_info.info_uint_cur())
            self.default = Self.Value(_info.info_uint_dflt())
            if _info.info_uint_has_min():
                self.minimum = Self.Value(_info.info_uint_min())
            if _info.info_uint_has_max():
                self.maximum = Self.Value(_info.info_uint_max())
        elif kind == Cvc5OptionInfoKind.DOUBLE:
            self.type = String("float")
            self.current = Self.Value(_info.info_double_cur())
            self.default = Self.Value(_info.info_double_dflt())
            if _info.info_double_has_min():
                self.minimum = Self.Value(_info.info_double_min())
            if _info.info_double_has_max():
                self.maximum = Self.Value(_info.info_double_max())
        elif kind == Cvc5OptionInfoKind.MODES:
            self.type = String("mode")
            self.current = Self.Value(to_string(_info.info_mode_cur()))
            self.default = Self.Value(to_string(_info.info_mode_dflt()))
            self.modes = to_strings(_info.info_mode_modes(), _info.info_mode_num_modes())

    def write_to(self, mut writer: Some[Writer]):
        """Write the information as Python prints its dict.

        For example `{'name': 'verbosity', 'aliases': [], 'setByUser': False,
        'category': <OptionCategory.COMMON: 2>, 'type': <class 'int'>,
        'current': 0, 'default': 0, 'minimum': None, 'maximum': None}`.

        Args:
            writer: The writer.
        """
        writer.write("{'name': ")
        write_python_repr(writer, self.name)
        writer.write(", 'aliases': ")
        _write_list(writer, self.aliases)
        writer.write(", 'setByUser': ", self.setByUser, ", 'category': ")
        self.category.write_repr_to(writer)
        writer.write(", 'type': ")
        if not self.type:
            writer.write("None}")
            return
        var type = self.type.value()
        if type == "mode":
            writer.write("'mode'")
        else:
            writer.write("<class '", type, "'>")
        writer.write(", 'current': ")
        _write_value(writer, self.current)
        writer.write(", 'default': ")
        _write_value(writer, self.default)
        if type == "int" or type == "float":
            writer.write(", 'minimum': ")
            _write_value(writer, self.minimum)
            writer.write(", 'maximum': ")
            _write_value(writer, self.maximum)
        if type == "mode":
            writer.write(", 'modes': ")
            _write_list(writer, self.modes)
        writer.write("}")


def _write_list(mut writer: Some[Writer], items: List[String]):
    """Write a list of strings as Python prints it.

    Args:
        writer: The writer.
        items: The strings.
    """
    writer.write("[")
    for i in range(len(items)):
        if i:
            writer.write(", ")
        write_python_repr(writer, items[i])
    writer.write("]")


def _write_value(mut writer: Some[Writer], value: Optional[OptionInfo.Value]):
    """Write an option value as Python prints it.

    Args:
        writer: The writer.
        value: The value, if any.
    """
    if not value:
        writer.write("None")
        return
    ref v = value.value()
    if v.isa[Bool]():
        writer.write(v[Bool])
    elif v.isa[String]():
        write_python_repr(writer, v[String])
    elif v.isa[Int]():
        writer.write(v[Int])
    elif v.isa[UInt64]():
        writer.write(v[UInt64])
    else:
        writer.write(v[Float64])  # Mojo's shortest form is Python's repr
