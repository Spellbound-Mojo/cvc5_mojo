        """Define recursive functions.

        Supports the following arguments:

        - `Term defineFunRec(str symbol, List[Term] bound_vars, Sort sort, Term term, bool glbl)`
        - `Term defineFunRec(Term fun, List[Term] bound_vars, Term term, bool glbl)`

        SMT-LIB:

        ```text
        ( define-funs-rec ( <function_decl>^n ) ( <term>^n ) )
        ```

        Create elements of parameter `funs` with `mkConst()`.

        Returns:
            The function.
        """
        with _CallbackCall(self._o[].callbacks):
            var api = self._o[].api
            var bound_vars_c = List[Cvc5Term](capacity=len(bound_vars))
            for x in bound_vars:
                bound_vars_c.append(x._h)
            var result = api[].cvc5_define_fun_rec_from_const(self._handle(), fun._h, UInt(len(bound_vars_c)), bound_vars_c.unsafe_ptr(), term._h, glbl)
            return Term._received(api, self._o[].tm, result)

    def defineFunsRec(self, funs: List[Term], bound_vars: List[List[Term]], terms: List[Term], glb: Bool = False) raises:
        """Define recursive functions.

        SMT-LIB:

        ```text
        ( define-funs-rec ( <function_decl>^n ) ( <term>^n ) )
        ```

        Create elements of parameter `funs` with `mkConst()`.

        Args:
            funs: The sorted functions.
            bound_vars: The list of parameters to the functions.
            terms: The list of function bodies of the functions.
            glb: Determines whether this definition is global (i.e.
                persists when popping the context).
        """
        with _CallbackCall(self._o[].callbacks):
            var api = self._o[].api
            var funs_c = List[Cvc5Term](capacity=len(funs))
            for x in funs:
                funs_c.append(x._h)
            if len(bound_vars) != len(funs):
                raise Error("cvc5_mojo: `bound_vars` and `funs` must have the same length")
            var bound_vars_inner = List[List[Cvc5Term]](capacity=len(bound_vars))
            var bound_vars_sizes = List[UInt](capacity=len(bound_vars))
            for xs in bound_vars:
                var inner_c = List[Cvc5Term](capacity=len(xs))
                for x in xs:
                    inner_c.append(x._h)
                bound_vars_sizes.append(UInt(len(inner_c)))
                bound_vars_inner.append(inner_c^)
            var bound_vars_c = List[Pointer[Cvc5Term, MutUntrackedOrigin]](capacity=len(bound_vars_inner))
            for i in range(len(bound_vars_inner)):
                bound_vars_c.append(bound_vars_inner[i].unsafe_ptr().unsafe_origin_cast[MutUntrackedOrigin]())
            if len(terms) != len(funs):
                raise Error("cvc5_mojo: `terms` and `funs` must have the same length")
            var terms_c = List[Cvc5Term](capacity=len(terms))
            for x in terms:
                terms_c.append(x._h)
            api[].cvc5_define_funs_rec(self._handle(), UInt(len(funs_c)), funs_c.unsafe_ptr(), bound_vars_sizes.unsafe_ptr(), bound_vars_c.unsafe_ptr(), terms_c.unsafe_ptr(), glb)
            _ = bound_vars_inner^

    def getProof(self, c: ProofComponent = ProofComponent.FULL) raises -> List[Proof]:
        """Get a proof associated with the most recent call to checkSat.

        SMT-LIB:

        ```text
        (get-proof :c)
        ```

        Requires to enable option
        `produce-proofs`.

        !!! warning

            This function is experimental and may change in future versions.

        Args:
            c: The component of the proof to return.

        Returns:
            A vector of proof nodes.
        """
        with _CallbackCall(self._o[].callbacks):
            var api = self._o[].api
            var size = UInt(0)
            var result = api[].cvc5_get_proof(self._handle(), c, Pointer(to=size))
            var items = List[Proof](capacity=Int(size))
            for i in range(Int(size)):
                items.append(Proof._received(api, self._o[].tm, result[unsafe_offset=i], self._o))
            return items^

    def proofToString(self, proof: Proof, format: ProofFormat = ProofFormat.DEFAULT, assertionNames: Dict[Term, String] = Dict[Term, String]()) raises -> String:
        """Prints proof into a string with a selected proof format mode. Other aspects of printing are taken from the solver options.

        !!! warning

            This function is experimental and may change in future versions.

        Args:
            proof: A proof, usually obtained from
                `getProof()`.
            format: The proof format used to print the proof.  Must be
                "None" if the proof is not a full proof.
            assertionNames: Mapping between assertions and names, if
                they were  given by the user.  This is used
                by the Alethe proof format.

        Returns:
            The proof printed in the current format.
        """
        with _CallbackCall(self._o[].callbacks):
            var api = self._o[].api
            var assertionNames_keys_c = List[Cvc5Term](capacity=len(assertionNames))
            for x in assertionNames.keys():
                assertionNames_keys_c.append(x._h)
            var assertionNames_values_bytes = List[List[Int8]](capacity=len(assertionNames))
            var assertionNames_values_c = List[CChars](capacity=len(assertionNames))
            for s in assertionNames.values():
                assertionNames_values_bytes.append(c_bytes(s))
            for i in range(len(assertionNames_values_bytes)):
                assertionNames_values_c.append(assertionNames_values_bytes[i].unsafe_ptr().unsafe_origin_cast[MutUntrackedOrigin]())
            var result = api[].cvc5_proof_to_string(self._handle(), proof._h, format, UInt(len(assertionNames_keys_c)), assertionNames_keys_c.unsafe_ptr(), assertionNames_values_c.unsafe_ptr())
            _ = assertionNames_values_bytes^
            return to_string(result)

    def getLearnedLiterals(self, type_: LearnedLitType = LearnedLitType.INPUT) raises -> List[Term]:
        """Get a list of literals that are entailed by the current set of assertions.

        SMT-LIB:

        ```text
        ( get-learned-literals )
        ```

        !!! warning

            This function is experimental and may change in future versions.

        Returns:
            The list of literals.
        """
        with _CallbackCall(self._o[].callbacks):
            var api = self._o[].api
            var size = UInt(0)
            var result = api[].cvc5_get_learned_literals(self._handle(), type_, Pointer(to=size))
            var items = List[Term](capacity=Int(size))
            for i in range(Int(size)):
                items.append(Term._received(api, self._o[].tm, result[unsafe_offset=i]))
            return items^

