def test_mk_skolem() raises:
    var tm = TermManager()
    var integer = tm.getIntegerSort()
    var arraySort = tm.mkArraySort(integer, integer)
    var a = tm.mkConst(arraySort, "a")
    var b = tm.mkConst(arraySort, "b")
    var sk = tm.mkSkolem(SkolemId.ARRAY_DEQ_DIFF, a, b)
    var sk2 = tm.mkSkolem(SkolemId.ARRAY_DEQ_DIFF, b, a)
    assert_true(sk.isSkolem())
    assert_true(sk2.isSkolem())
    assert_true((sk.getSkolemId() == SkolemId.ARRAY_DEQ_DIFF))
    assert_true((sk2.getSkolemId() == SkolemId.ARRAY_DEQ_DIFF))
    assert_true((sk.getSkolemIndices() == [a, b]))
    assert_true((sk2.getSkolemIndices() == [a, b]))


