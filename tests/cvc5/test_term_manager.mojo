def test_declare_fun_fresh() raises:
    var tm = TermManager()
    var solver = Solver(tm)
    var boolSort = tm.getBooleanSort()
    var intSort = tm.getIntegerSort()
    var t1 = solver.declareFun("b", [], boolSort, True)
    var t2 = solver.declareFun("b", [], boolSort, False)
    var t3 = solver.declareFun("b", [], boolSort, False)
    assert_true((t1 != t2))
    assert_true((t1 != t3))
    assert_true((t2 == t3))
    var t4 = solver.declareFun("c", [], boolSort, False)
    assert_true((t2 != t4))
    var t5 = solver.declareFun("b", [], intSort, False)
    assert_true((t2 != t5))


