def test_uf_iteration() raises:
    var tm = TermManager()
    var solver = Solver(tm)
    var intSort = tm.getIntegerSort()
    var funSort = tm.mkFunctionSort([intSort, intSort], intSort)
    var x = tm.mkConst(intSort, "x")
    var y = tm.mkConst(intSort, "y")
    var f = tm.mkConst(funSort, "f")
    var fxy = tm.mkTerm(Kind.APPLY_UF, f, x, y)
    var expected_children: List[type_of(f)] = [f, x, y]
    var idx = 0
    for c in fxy:
        assert_true((idx < 3))
        assert_true((c == expected_children[idx]))
        idx = (idx + 1)


def test_get_statistics() raises:
    var tm = TermManager()
    var solver = Solver(tm)
    var intSort = tm.getIntegerSort()
    var x = tm.mkConst(intSort, "x")
    var y = tm.mkConst(intSort, "y")
    var zero = tm.mkInteger(0)
    var ten = tm.mkInteger(10)
    var f0 = tm.mkTerm(Kind.GEQ, x, ten)
    var f1 = tm.mkTerm(Kind.OR, tm.mkTerm(Kind.GEQ, zero, x), tm.mkTerm(Kind.GEQ, y, zero))
    solver.assertFormula(f0)
    solver.assertFormula(f1)
    _ = solver.checkSat()
    var stats = tm.getStatistics()
    assert_true(((stats["cvc5::TERM"].default == False) and (stats["cvc5::TERM"].internal == False) and (((stats["cvc5::TERM"].value.isa[Dict[String, UInt64]]() and (stats["cvc5::TERM"].value[Dict[String, UInt64]] == {"GEQ": 3, "OR": 1}))))))
    assert_true((len(stats.get(True, False)) != 0))
    for s in stats:
        if (s[0] == "cvc5::CONTANT"):
            assert_false(s[1].internal)
            assert_false(s[1].default)
            assert_true((((s[1].value.isa[Dict[String, UInt64]]() and (s[1].value[Dict[String, UInt64]] == {"integer type": 1})))))


