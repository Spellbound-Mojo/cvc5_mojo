def test_mk_nullable_lift() raises:
    var tm = TermManager()
    var solver = Solver(tm)
    var some1 = tm.mkNullableSome(tm.mkInteger(1))
    var some2 = tm.mkNullableSome(tm.mkInteger(2))
    var some3 = tm.mkNullableLift(Kind.ADD, some1, some2)
    var three = solver.simplify(tm.mkNullableVal(some3))
    assert_true((Int(three.getIntegerValue()) == 3))
    var ttm = TermManager()
    var _raised1 = False
    try:
        _ = ttm.mkNullableLift(Kind.ADD, tm.mkNullableSome(tm.mkInteger(1)), tm.mkNullableSome(tm.mkInteger(2)))
    except:
        _raised1 = True
    assert_true(_raised1, "expected an error")


