def test_mk_term_from_op() raises:
    var tm = TermManager()
    var bv32 = tm.mkBitVectorSort(32)
    var a = tm.mkConst(bv32, "a")
    var b = tm.mkConst(bv32, "b")
    var opterm1 = tm.mkOp(Kind.BITVECTOR_EXTRACT, 2, 1)
    var opterm2 = tm.mkOp(Kind.DIVISIBLE, 1)
    var sort = tm.mkParamSort("T")
    var listDecl = tm.mkDatatypeDecl("paramlist", [sort])
    var cons = tm.mkDatatypeConstructorDecl("cons")
    var nil = tm.mkDatatypeConstructorDecl("nil")
    cons.addSelector("head", sort)
    cons.addSelectorSelf("tail")
    listDecl.addConstructor(cons)
    listDecl.addConstructor(nil)
    var listSort = tm.mkDatatypeSort(listDecl)
    var intListSort = listSort.instantiate([tm.getIntegerSort()])
    var c = tm.mkConst(intListSort, "c")
    var lis = listSort.getDatatype()
    var consTerm = lis.getConstructor("cons").getTerm()
    var nilTerm = lis.getConstructor("nil").getTerm()
    var headTerm = lis["cons"].getSelector("head").getTerm()
    var tailTerm = lis["cons"]["tail"].getTerm()
    _ = tm.mkTerm(Kind.APPLY_CONSTRUCTOR, nilTerm)
    _ = tm.mkTerm(Kind.APPLY_CONSTRUCTOR, nilTerm)
    var _raised1 = False
    try:
        _ = tm.mkTerm(Kind.APPLY_SELECTOR, nilTerm)
    except:
        _raised1 = True
    assert_true(_raised1, "expected an error")
    var _raised2 = False
    try:
        _ = tm.mkTerm(Kind.APPLY_SELECTOR, consTerm)
    except:
        _raised2 = True
    assert_true(_raised2, "expected an error")
    var _raised3 = False
    try:
        _ = tm.mkTerm(Kind.APPLY_CONSTRUCTOR, consTerm)
    except:
        _raised3 = True
    assert_true(_raised3, "expected an error")
    var _raised4 = False
    try:
        _ = tm.mkTerm(opterm1)
    except:
        _raised4 = True
    assert_true(_raised4, "expected an error")
    var _raised5 = False
    try:
        _ = tm.mkTerm(Kind.APPLY_SELECTOR, headTerm)
    except:
        _raised5 = True
    assert_true(_raised5, "expected an error")
    var _raised6 = False
    try:
        _ = tm.mkTerm(opterm1)
    except:
        _raised6 = True
    assert_true(_raised6, "expected an error")
    _ = tm.mkTerm(opterm1, a)
    _ = tm.mkTerm(opterm2, tm.mkInteger(1))
    _ = tm.mkTerm(Kind.APPLY_SELECTOR, headTerm, c)
    _ = tm.mkTerm(Kind.APPLY_SELECTOR, tailTerm, c)
    var _raised7 = False
    try:
        _ = tm.mkTerm(opterm2, a)
    except:
        _raised7 = True
    assert_true(_raised7, "expected an error")
    var _raised8 = False
    try:
        _ = tm.mkTerm(Kind.APPLY_CONSTRUCTOR, consTerm, tm.mkInteger(0))
    except:
        _raised8 = True
    assert_true(_raised8, "expected an error")
    _ = tm.mkTerm(Kind.APPLY_CONSTRUCTOR, consTerm, tm.mkInteger(0), tm.mkTerm(Kind.APPLY_CONSTRUCTOR, nilTerm))
    var _raised9 = False
    try:
        _ = tm.mkTerm(opterm2, tm.mkInteger(1), tm.mkInteger(2))
    except:
        _raised9 = True
    assert_true(_raised9, "expected an error")
    var _raised10 = False
    try:
        _ = tm.mkTerm(opterm1, a, b)
    except:
        _raised10 = True
    assert_true(_raised10, "expected an error")
    var _raised11 = False
    try:
        _ = tm.mkTerm(opterm1, a, b, a)
    except:
        _raised11 = True
    assert_true(_raised11, "expected an error")
    _ = tm.mkTerm(opterm2, tm.mkInteger(5))
    var _raised12 = False
    try:
        _ = tm.mkTerm(opterm2, tm.mkInteger(1), tm.mkInteger(2))
    except:
        _raised12 = True
    assert_true(_raised12, "expected an error")
    var _raised13 = False
    try:
        _ = tm.mkTerm(opterm2)
    except:
        _raised13 = True
    assert_true(_raised13, "expected an error")
    var ttm = TermManager()
    var _raised14 = False
    try:
        _ = ttm.mkTerm(opterm2, ttm.mkInteger(1))
    except:
        _raised14 = True
    assert_true(_raised14, "expected an error")
    var _raised15 = False
    try:
        _ = ttm.mkTerm(ttm.mkOp(Kind.DIVISIBLE, 1), tm.mkInteger(1))
    except:
        _raised15 = True
    assert_true(_raised15, "expected an error")


