def test_mk_floating_point() raises:
    var tm = TermManager()
    var t1 = tm.mkBitVector(8)
    var t2 = tm.mkBitVector(4)
    var t3 = tm.mkInteger(2)
    _ = tm.mkFloatingPoint(3, 5, t1)
    var _raised1 = False
    try:
        _ = tm.mkFloatingPoint(0, 5, t1)
    except:
        _raised1 = True
    assert_true(_raised1, "expected an error")
    var _raised2 = False
    try:
        _ = tm.mkFloatingPoint(3, 0, t1)
    except:
        _raised2 = True
    assert_true(_raised2, "expected an error")
    var _raised3 = False
    try:
        _ = tm.mkFloatingPoint(3, 5, t2)
    except:
        _raised3 = True
    assert_true(_raised3, "expected an error")
    var _raised4 = False
    try:
        _ = tm.mkFloatingPoint(3, 5, t2)
    except:
        _raised4 = True
    assert_true(_raised4, "expected an error")
    var sign = tm.mkBitVector(1)
    var exp = tm.mkBitVector(5)
    var sig = tm.mkBitVector(10)
    var bv = tm.mkBitVector(16)
    var a = tm.mkFloatingPoint(sign, exp, sig)
    assert_true((tm.mkFloatingPoint(sign, exp, sig) == tm.mkFloatingPoint(5, 11, bv)))
    var ttm = TermManager()
    var _raised5 = False
    try:
        _ = ttm.mkFloatingPoint(3, 5, t1)
    except:
        _raised5 = True
    assert_true(_raised5, "expected an error")
    var _raised6 = False
    try:
        _ = ttm.mkFloatingPoint(tm.mkBitVector(1), ttm.mkBitVector(5), ttm.mkBitVector(10))
    except:
        _raised6 = True
    assert_true(_raised6, "expected an error")
    var _raised7 = False
    try:
        _ = ttm.mkFloatingPoint(ttm.mkBitVector(1), tm.mkBitVector(5), ttm.mkBitVector(10))
    except:
        _raised7 = True
    assert_true(_raised7, "expected an error")
    var _raised8 = False
    try:
        _ = ttm.mkFloatingPoint(ttm.mkBitVector(1), ttm.mkBitVector(5), tm.mkBitVector(10))
    except:
        _raised8 = True
    assert_true(_raised8, "expected an error")


def test_mk_cardinality_constraint() raises:
