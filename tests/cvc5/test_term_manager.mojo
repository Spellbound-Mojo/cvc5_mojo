def test_mk_finite_field_elem() raises:
    var tm = TermManager()
    var bv = tm.mkBitVectorSort(4)
    var _raised1 = False
    try:
        _ = tm.mkFiniteFieldElem("-1", bv)
    except:
        _raised1 = True
    assert_true(_raised1, "expected an error")
    # Python expects ValueError; Mojo rejects these arguments at compile time:
    #     tm.mkFiniteFieldElem(tm, bv)
    var f = tm.mkFiniteFieldSort("7")
    _ = tm.mkFiniteFieldElem("0", f)
    _ = tm.mkFiniteFieldElem("1", f)
    _ = tm.mkFiniteFieldElem("6", f)
    _ = tm.mkFiniteFieldElem("8", f)
    _ = tm.mkFiniteFieldElem("-1", f)
    var _raised2 = False
    try:
        _ = tm.mkFiniteFieldElem("b", f)
    except:
        _raised2 = True
    assert_true(_raised2, "expected an error")
    _ = tm.mkFiniteFieldElem(10, f)
    _ = tm.mkFiniteFieldSort("b", 16)
    var _raised3 = False
    try:
        _ = tm.mkFiniteFieldSort("a", 16)
    except:
        _raised3 = True
    assert_true(_raised3, "expected an error")
    _ = tm.mkFiniteFieldElem("18", f, 16)
    # Python expects ValueError; Mojo rejects these arguments at compile time:
    #     tm.mkFiniteFieldElem(24, f, 16)
    assert_true((tm.mkFiniteFieldElem(10, f) == tm.mkFiniteFieldElem("10", f)))
    assert_true((tm.mkFiniteFieldElem("-1", f) == tm.mkFiniteFieldElem("6", f)))
    assert_true((tm.mkFiniteFieldElem("1", f) == tm.mkFiniteFieldElem("8", f)))
    _ = tm.mkFiniteFieldElem("0", f, 2)
    _ = tm.mkFiniteFieldElem("101", f, 3)
    _ = tm.mkFiniteFieldElem("-10", f, 7)
    _ = tm.mkFiniteFieldElem("abcde", f, 16)
    assert_true((tm.mkFiniteFieldElem("0", f, 2) == tm.mkFiniteFieldElem("0", f, 3)))
    assert_true((tm.mkFiniteFieldElem("11", f, 2) == tm.mkFiniteFieldElem("10", f, 3)))
    assert_true((tm.mkFiniteFieldElem("1010", f, 2) == tm.mkFiniteFieldElem("A", f, 16)))
    assert_true((tm.mkFiniteFieldElem("-22", f, 3) == tm.mkFiniteFieldElem("10", f, 6)))


