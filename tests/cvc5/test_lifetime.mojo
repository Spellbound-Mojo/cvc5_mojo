from std.testing import assert_false, assert_true

from cvc5_mojo import Kind, Solver, TermManager


def test_sort_outlives_term_manager() raises:
    var tm = TermManager()
    var s = tm.getIntegerSort()
    var arr = tm.mkArraySort(s, tm.getBooleanSort())
    _ = tm^
    assert_true(s.isInteger())
    assert_true(arr.isArray())
    assert_true((s == arr.getArrayIndexSort()))
    assert_true(String(s))


def test_term_outlives_term_manager() raises:
    var tm = TermManager()
    var int_sort = tm.getIntegerSort()
    var x = tm.mkConst(int_sort, "x")
    var t = tm.mkTerm(Kind.ADD, x, tm.mkInteger(1))
    _ = tm^
    assert_true((t.getKind() == Kind.ADD))
    assert_true((t.getSort() == int_sort))
    assert_true((t.getNumChildren() == 2))
    assert_true(String(t))


def test_op_outlives_term_manager() raises:
    var tm = TermManager()
    var op = tm.mkOp(Kind.BITVECTOR_EXTRACT, 4, 0)
    _ = tm^
    assert_true(op.isIndexed())
    assert_true((op.getKind() == Kind.BITVECTOR_EXTRACT))
    assert_true((op.getNumIndices() == 2))
    _ = op[0]  # a `Term` is never None
    assert_true(String(op))


def test_term_iterator_outlives_term_manager() raises:
    var tm = TermManager()
    var b = tm.getBooleanSort()
    var t = tm.mkTerm(Kind.AND, tm.mkConst(b, "x"), tm.mkConst(b, "y"))
    _ = tm^
    var count = 0
    for child in t:
        assert_false(child.isNull())
        count += 1
    assert_true((count == 2))


def test_datatype_outlives_term_manager() raises:
    var tm = TermManager()
    var decl = tm.mkDatatypeDecl("list")
    var cons = tm.mkDatatypeConstructorDecl("cons")
    cons.addSelector("head", tm.getIntegerSort())
    cons.addSelectorSelf("tail")
    decl.addConstructor(cons)
    var nil = tm.mkDatatypeConstructorDecl("nil")
    decl.addConstructor(nil)
    var list_sort = tm.mkDatatypeSort(decl)
    _ = tm^
    var dt = list_sort.getDatatype()
    assert_true((dt.getName() == "list"))
    assert_true((dt.getNumConstructors() == 2))
    var num_ctors = 0
    for ctor in dt:
        assert_true(ctor.getName())
        for sel in ctor:
            assert_true(sel.getName())
        num_ctors += 1
    assert_true((num_ctors == 2))
    var cons_ctor = dt.getConstructor("cons")
    assert_true((cons_ctor.getName() == "cons"))
    var head = cons_ctor.getSelector("head")
    assert_true((head.getName() == "head"))
    assert_true(head.getCodomainSort().isInteger())


def test_solver_outlives_term_manager() raises:
    var tm = TermManager()
    var solver = Solver(tm)
    _ = tm^
    var tm2 = solver.getTermManager()
    var x = tm2.mkConst(tm2.getBooleanSort(), "x")
    solver.assertFormula(x)
    assert_true(solver.checkSat().isSat())


def test_value_outlives_solver_and_term_manager() raises:
    var tm = TermManager()
    var solver = Solver(tm)
    solver.setOption("produce-models", "true")
    var int_sort = tm.getIntegerSort()
    var x = tm.mkConst(int_sort, "x")
    solver.assertFormula(tm.mkTerm(Kind.GT, x, tm.mkInteger(0)))
    assert_true(solver.checkSat().isSat())
    var value = solver.getValue(x)
    _ = solver^
    _ = tm^
    assert_false(value.isNull())
    assert_true(value.getSort().isInteger())
    assert_true(String(value))


def test_grammar_outlives_solver_and_term_manager() raises:
    var tm = TermManager()
    var solver = Solver(tm)
    solver.setOption("sygus", "true")
    var b = tm.getBooleanSort()
    var start = tm.mkVar(b)
    var g = solver.mkGrammar([], [start])
    g.addRule(start, tm.mkBoolean(False))
    _ = solver^
    _ = tm^
    assert_true((String(g) != ""))


def test_proof_outlives_solver_and_term_manager() raises:
    var tm = TermManager()
    var solver = Solver(tm)
    solver.setOption("produce-proofs", "true")
    var b = tm.getBooleanSort()
    var x = tm.mkConst(b, "x")
    solver.assertFormula(x)
    solver.assertFormula(x.notTerm())
    assert_false(solver.checkSat().isSat())
    var proof = solver.getProof()[0]
    _ = solver^
    _ = tm^
    _ = proof.getRule()
    _ = proof.getResult()
    _ = proof.getChildren()


