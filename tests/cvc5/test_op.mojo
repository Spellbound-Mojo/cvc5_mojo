    assert_true((floatingopint_to_sbv[0].getIntegerValue() == 13))
    assert_true((regexp_repeat[0].getIntegerValue() == 14))
    var bitvector_extract = tm.mkOp(Kind.BITVECTOR_EXTRACT, 1, 0)
    var floatingpoint_to_fp_from_ieee_bv = tm.mkOp(Kind.FLOATINGPOINT_TO_FP_FROM_IEEE_BV, 3, 2)
