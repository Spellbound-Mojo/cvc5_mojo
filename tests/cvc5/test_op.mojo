    assert_true((bitvector_extract[0].getIntegerValue() == 1))
    assert_true((bitvector_extract[1].getIntegerValue() == 0))
    assert_true((floatingpoint_to_fp_from_ieee_bv[0].getIntegerValue() == 3))
    assert_true((floatingpoint_to_fp_from_ieee_bv[1].getIntegerValue() == 2))
    assert_true((floatingpoint_to_fp_from_fp[0].getIntegerValue() == 5))
    assert_true((floatingpoint_to_fp_from_fp[1].getIntegerValue() == 4))
    assert_true((floatingpoint_to_fp_from_real[0].getIntegerValue() == 7))
    assert_true((floatingpoint_to_fp_from_real[1].getIntegerValue() == 6))
    assert_true((floatingpoint_to_fp_from_sbv[0].getIntegerValue() == 9))
