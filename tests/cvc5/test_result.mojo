def test_eq() raises:
    var tm = TermManager()
    var solver = Solver(tm)
    var u_sort = tm.mkUninterpretedSort("u")
    var x = tm.mkConst(u_sort, "x")
    solver.assertFormula(x.eqTerm(x))
    var res2 = solver.checkSat()
    var res3 = solver.checkSat()
    var res = Result()
    assert_true((res != res2))
    res = res2
    assert_true((res == res2))
    assert_true((res3 == res2))
    assert_true((String(res) == "sat"))


def test_is_sat() raises:
    var tm = TermManager()
    var solver = Solver(tm)
    var u_sort = tm.mkUninterpretedSort("u")
    var x = tm.mkConst(u_sort, "x")
    solver.assertFormula(x.eqTerm(x))
    var res = solver.checkSat()
    assert_true(res.isSat())
    assert_false(res.isUnknown())


def test_is_unsat() raises:
    var tm = TermManager()
    var solver = Solver(tm)
    var u_sort = tm.mkUninterpretedSort("u")
    var x = tm.mkConst(u_sort, "x")
    solver.assertFormula(x.eqTerm(x).notTerm())
    var res = solver.checkSat()
    assert_true(res.isUnsat())
    assert_false(res.isUnknown())


def test_is_sat_unknown() raises:
    var tm = TermManager()
    var solver = Solver(tm)
    solver.setLogic("QF_NIA")
    solver.setOption("incremental", "false")
    solver.setOption("solve-real-as-int", "true")
    var real_sort = tm.getRealSort()
    var x = tm.mkConst(real_sort, "x")
    solver.assertFormula(tm.mkTerm(Kind.LT, tm.mkReal("0.0"), x))
    solver.assertFormula(tm.mkTerm(Kind.LT, x, tm.mkReal("1.0")))
    var res = solver.checkSat()
    assert_false(res.isSat())
    assert_true(res.isUnknown())
    var ue = res.getUnknownExplanation()
    assert_true((ue == UnknownExplanation.INCOMPLETE))
    assert_true((String(ue) == "UnknownExplanation.INCOMPLETE"))


