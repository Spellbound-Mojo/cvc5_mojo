"""Unit tests `test_symbol_manager.py` of cvc5's Python API, translated to Mojo."""

from std.testing import assert_true

from cvc5_mojo import InputLanguage, InputParser, Solver, SymbolManager, TermManager


def parse_command(solver: Solver, sm: SymbolManager, cmd: String) raises:
    var parser = InputParser(solver, sm)
    parser.setIncrementalStringInput(InputLanguage.SMT_LIB_2_6, "test_symbol_manager_parser")
    parser.appendIncrementalStringInput(cmd)
    var cmd_1 = parser.nextCommand()
    assert_true((cmd_1.isNull() != True))
    _ = cmd_1.invoke(solver, sm)


def parse_and_set_logic(solver: Solver, sm: SymbolManager, logic: String) raises:
    parse_command(solver, sm, ((("(set-logic " + logic) + ")") + "\n"))


def test_is_logic_set() raises:
    var tm = TermManager()
    var solver = Solver(tm)
    var sm = SymbolManager(tm)
    assert_true((sm.isLogicSet() == False))
    parse_and_set_logic(solver, sm, "QF_LIA")
    assert_true((sm.isLogicSet() == True))


def test_get_logic() raises:
    var tm = TermManager()
    var solver = Solver(tm)
    var sm = SymbolManager(tm)
    var _raised1 = False
    try:
        _ = sm.getLogic()
    except:
        _raised1 = True
    assert_true(_raised1, "expected an error")
    parse_and_set_logic(solver, sm, "QF_LIA")
    assert_true((sm.getLogic() == "QF_LIA"))


def test_get_declared_terms_and_sorts() raises:
    var tm = TermManager()
    var solver = Solver(tm)
    var sm = SymbolManager(tm)
    assert_true((len(sm.getDeclaredSorts()) == 0))
    assert_true((len(sm.getDeclaredTerms()) == 0))


def test_get_named_terms() raises:
    var tm = TermManager()
    var solver = Solver(tm)
    var sm = SymbolManager(tm)
    parse_and_set_logic(solver, sm, "QF_LIA")
    assert_true((len(sm.getNamedTerms()) == 0))
    parse_command(solver, sm, "(assert (! false :named a0))")
    assert_true((len(sm.getNamedTerms()) == 1))


