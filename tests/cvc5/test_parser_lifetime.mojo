def test_declared_symbols_outlive_parser_and_managers() raises:
    var tm = TermManager()
    var solver = Solver(tm)
    var sm = SymbolManager(tm)
    var p = InputParser(solver, sm)
    p.setIncrementalStringInput(InputLanguage.SMT_LIB_2_6, "parser_lifetime")
    p.appendIncrementalStringInput("(set-logic ALL)\n")
    p.appendIncrementalStringInput("(declare-sort U 0)\n")
    p.appendIncrementalStringInput("(declare-fun a () Int)\n")
    p.appendIncrementalStringInput("(declare-fun b () U)\n")
    var cmd = p.nextCommand()
    while not cmd.isNull():
        _ = cmd.invoke(solver, sm)
        cmd = p.nextCommand()
    var terms = sm.getDeclaredTerms()
    var sorts = sm.getDeclaredSorts()
    assert_true((len(terms) == 2))
    assert_true((len(sorts) == 1))
    _ = p^
    _ = sm^
    _ = solver^
    _ = tm^
    for t in terms:
        assert_false(t.isNull())
        _ = t.getSort()
        assert_true(String(t))
    for s in sorts:
        assert_false(s.isNull())
        assert_true(String(s))


def test_parsed_term_outlives_parser_and_managers() raises:
    var tm = TermManager()
    var solver = Solver(tm)
    var sm = SymbolManager(tm)
    var p = InputParser(solver, sm)
    p.setIncrementalStringInput(InputLanguage.SMT_LIB_2_6, "parser_lifetime")
    p.appendIncrementalStringInput("(set-logic ALL)\n")
    p.appendIncrementalStringInput("(declare-fun x () Int)\n")
    var cmd = p.nextCommand()
    _ = cmd.invoke(solver, sm)
    cmd = p.nextCommand()
    _ = cmd.invoke(solver, sm)
    p.appendIncrementalStringInput("(+ x 1)\n")
    var t = p.nextTerm()
    _ = p^
    _ = sm^
    _ = solver^
    _ = tm^
    assert_false(t.isNull())
    assert_true((t.getKind() == Kind.ADD))
    assert_true(t.getSort().isInteger())
    assert_true(String(t))


