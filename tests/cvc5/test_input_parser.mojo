def test_multiple_parsers() raises:
    var tm = TermManager()
    var solver = Solver(tm)
    var sm = SymbolManager(tm)
    var p = InputParser(solver, sm)
    var cmd = parse_logic_command(p, "QF_LIA")
    _ = cmd.invoke(solver, sm)
    assert_true((solver.isLogicSet() == True))
    assert_true((solver.getLogic() == "QF_LIA"))
    assert_true((sm.isLogicSet() == True))
    assert_true((sm.getLogic() == "QF_LIA"))
    var _raised1 = False
    try:
        solver.setLogic("QF_LRA")
    except:
        _raised1 = True
    assert_true(_raised1, "expected an error")
    var p2 = InputParser(solver, p.getSymbolManager())
    var s2 = Solver(tm)
    var p3 = InputParser(s2, sm)
    p3.setIncrementalStringInput(InputLanguage.SMT_LIB_2_6, "test_input_parser")
    assert_true((s2.isLogicSet() == True))
    assert_true((s2.getLogic() == "QF_LIA"))
    var _raised2 = False
    try:
        _ = parse_logic_command(p3, "QF_LRA")
    except:
        _raised2 = True
    assert_true(_raised2, "expected an error")
    assert_true((p3.done() == True))
    var s3 = Solver(tm)
    s3.setLogic("QF_LIA")
    var p4 = InputParser(s3, sm)
    p4.setIncrementalStringInput(InputLanguage.SMT_LIB_2_6, "test_input_parser")
    var s4 = Solver(tm)
    s4.setLogic("QF_LRA")
    var p5 = InputParser(s4, sm)
    var _raised3 = False
    try:
        p5.setIncrementalStringInput(InputLanguage.SMT_LIB_2_6, "test_input_parser")
    except:
        _raised3 = True
    assert_true(_raised3, "expected an error")


def test_get_declared_terms_and_sorts() raises:
    var tm = TermManager()
    var solver = Solver(tm)
    var sm = SymbolManager(tm)
    var p = InputParser(solver, sm)
    p.setIncrementalStringInput(InputLanguage.SMT_LIB_2_6, "test_input_parser")
    p.appendIncrementalStringInput("(set-logic ALL)")
    p.appendIncrementalStringInput("(declare-sort U 0)")
    p.appendIncrementalStringInput("(declare-fun x () U)")
    for i in [0, 1, 2]:
        var cmd = p.nextCommand()
        assert_true((cmd.isNull() != True))
        _ = cmd.invoke(solver, sm)
    var sorts = sm.getDeclaredSorts()
    var terms = sm.getDeclaredTerms()
    assert_true((len(sorts) == 1))
    assert_true((len(terms) == 1))
    assert_true((terms[0].getSort() == sorts[0]))


