def test_get_real_algebraic_number() raises:
    var tm = TermManager()
    var solver = Solver(tm)
    solver.setOption("produce-models", "true")
    solver.setLogic("QF_NRA")
    var realsort = tm.getRealSort()
    var x = tm.mkConst(realsort, "x")
    var x2 = tm.mkTerm(Kind.MULT, x, x)
    var two = tm.mkReal(2, 1)
    var eq = tm.mkTerm(Kind.EQUAL, x2, two)
    solver.assertFormula(eq)
    if solver.checkSat().isSat():
        var vx = solver.getValue(x)
        assert_true(vx.isRealAlgebraicNumber())
        var y = tm.mkVar(realsort, "y")
        var poly = vx.getRealAlgebraicNumberDefiningPolynomial(y)
        assert_false(poly.isNull())
        var lb = vx.getRealAlgebraicNumberLowerBound()
        assert_true(lb.isRealValue())
        var ub = vx.getRealAlgebraicNumberUpperBound()
        assert_true(ub.isRealValue())
        var yc = tm.mkConst(realsort, "y")
        var _raised1 = False
        try:
            vx.getRealAlgebraicNumberDefiningPolynomial(yc)
        except:
            _raised1 = True
        assert_true(_raised1, "expected an error")


def test_get_skolem() raises:
    var tm = TermManager()
    var solver = Solver(tm)
    var x = tm.mkConst(tm.getIntegerSort(), "x")
    assert_false(x.isSkolem())
    var _raised1 = False
    try:
        _ = x.getSkolemId()
    except:
        _raised1 = True
    assert_true(_raised1, "expected an error")
    var _raised2 = False
    try:
        _ = x.getSkolemIndices()
    except:
        _raised2 = True
    assert_true(_raised2, "expected an error")


def test_term_scoped_to_string() raises:
    var tm = TermManager()
    var intsort = tm.getIntegerSort()
    var x = tm.mkConst(intsort, "x")
    assert_true((String(x) == "x"))
    var tm2 = Solver(tm)
    assert_true((String(x) == "x"))


