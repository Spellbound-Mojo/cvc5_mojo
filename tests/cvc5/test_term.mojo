def test_get_uninterpreted_sort_value() raises:
    var tm = TermManager()
    var solver = Solver(tm)
    solver.setOption("produce-models", "true")
    var uSort = tm.mkUninterpretedSort("u")
    var x = tm.mkConst(uSort, "x")
    var y = tm.mkConst(uSort, "y")
    solver.assertFormula(tm.mkTerm(Kind.EQUAL, x, y))
    assert_true(solver.checkSat().isSat())
    var vx = solver.getValue(x)
    var vy = solver.getValue(y)
    assert_true(vx.isUninterpretedSortValue())
    assert_true(vy.isUninterpretedSortValue())
    assert_true((vx.getUninterpretedSortValue() == vy.getUninterpretedSortValue()))


def test_is_rounding_mode_value() raises:
