def test_term_assignment() raises:
    var tm = TermManager()
    var t1 = tm.mkInteger(1)
    var t2 = t1
    t2 = tm.mkInteger(2)
    assert_true((t1 == tm.mkInteger(1)))


def test_substitute() raises:
    var tm = TermManager()
    var x = tm.mkConst(tm.getIntegerSort(), "x")
    var one = tm.mkInteger(1)
    var ttrue = tm.mkTrue()
    var xpx = tm.mkTerm(Kind.ADD, x, x)
    var onepone = tm.mkTerm(Kind.ADD, one, one)
    assert_true((xpx.substitute(x, one) == onepone))
    assert_true((onepone.substitute(one, x) == xpx))
    var _raised1 = False
    try:
        _ = xpx.substitute(one, ttrue)
    except:
        _raised1 = True
    assert_true(_raised1, "expected an error")
    var y = tm.mkConst(tm.getIntegerSort(), "y")
    var xpy = tm.mkTerm(Kind.ADD, x, y)
    var xpone = tm.mkTerm(Kind.ADD, y, one)
    var es = List[Term]()
    var rs = List[Term]()
    es.append(x)
    rs.append(y)
    es.append(y)
    rs.append(one)
    assert_true((xpy.substitute(es, rs) == xpone))
    rs.pop()
    var _raised2 = False
    try:
        _ = xpy.substitute(es, rs)
    except:
        _raised2 = True
    assert_true(_raised2, "expected an error")
    rs.append(ttrue)
    var _raised3 = False
    try:
        _ = xpy.substitute(es, rs)
    except:
        _raised3 = True
    assert_true(_raised3, "expected an error")


def test_term_compare() raises:
    var tm = TermManager()
    var t1 = tm.mkInteger(1)
    var t2 = tm.mkTerm(Kind.ADD, tm.mkInteger(2), tm.mkInteger(2))
    var t3 = tm.mkTerm(Kind.ADD, tm.mkInteger(2), tm.mkInteger(2))
    assert_true((t2 >= t3))
    assert_true((t2 <= t3))
    assert_true(((t1 > t2) != (t1 < t2)))
    assert_true((((t1 > t2) or (t1 == t2)) == (t1 >= t2)))


def test_term_children() raises:
    var tm = TermManager()
    var two = tm.mkInteger(2)
    var t1 = tm.mkTerm(Kind.ADD, two, tm.mkInteger(3))
    assert_true((t1[0] == two))
    assert_true((t1.getNumChildren() == 2))
    var intSort = tm.getIntegerSort()
    var fsort = tm.mkFunctionSort(intSort, intSort)
    var f = tm.mkConst(fsort, "f")
    var t2 = tm.mkTerm(Kind.APPLY_UF, f, two)
    assert_true((t2.getNumChildren() == 2))
    assert_true((t2[0] == f))
    assert_true((t2[1] == two))


