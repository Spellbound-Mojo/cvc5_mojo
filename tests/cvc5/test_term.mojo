def _collect_Term(values: Term) raises -> List[Term]:
    var result = List[Term]()
    for value in values:
        result.append(value.copy())
    return result^


def _set_equal[T: Copyable & Equatable](left: List[T], right: List[T]) -> Bool:
    for value in left:
        if value not in right:
            return False
    for value in right:
        if value not in left:
            return False
    return True


