def test_get_real() raises:
    var tm = TermManager()
    var real1 = tm.mkReal("0")
    var real2 = tm.mkReal(".0")
    var real3 = tm.mkReal("-17")
    var real4 = tm.mkReal("-3/5")
    var real5 = tm.mkReal("12.7")
    var real6 = tm.mkReal("1/4294967297")
    var real7 = tm.mkReal("4294967297")
    var real8 = tm.mkReal("1/18446744073709551617")
    var real9 = tm.mkReal("18446744073709551617")
    assert_true(real1.isRealValue())
    assert_true(real2.isRealValue())
    assert_true(real3.isRealValue())
    assert_true(real4.isRealValue())
    assert_true(real5.isRealValue())
    assert_true(real6.isRealValue())
    assert_true(real7.isRealValue())
    assert_true(real8.isRealValue())
    assert_true(real9.isRealValue())
    assert_true((real1.getRealValue() == Rational(0)))
    assert_true((real2.getRealValue() == Rational(0)))
    assert_true((real3.getRealValue() == Rational(-17)))
    assert_true((real4.getRealValue() == Rational(-3, 5)))
    assert_true((real5.getRealValue() == Rational(127, 10)))
    assert_true((real6.getRealValue() == Rational(1, 4294967297)))
    assert_true((real7.getRealValue() == Rational(4294967297)))
    assert_true((real8.getRealValue() == Rational(1, 18446744073709551617)))
    assert_true((real9.getRealValue() == Rational(18446744073709551617, 1)))
    var num = 1
    var den = Integer(18446744073709551617)
    var real_big = tm.mkReal(num, den)
    assert_true(real_big.isRealValue())
    assert_true((real_big.getRealValue() == Rational(num, den)))
    var real_decimal = tm.mkReal(0.3)
    assert_true(real_decimal.isRealValue())
    assert_true((real_decimal.getRealValue() == Rational(3, 10)))
    assert_true((Rational(5404319552844595, 18014398509481984) == Rational(5404319552844595, 18014398509481984)))
    assert_true((real_decimal.getRealValue() != Rational(5404319552844595, 18014398509481984)))
    var _raised1 = False
    try:
        _ = tm.mkReal("1/0")
    except:
        _raised1 = True
    assert_true(_raised1, "expected an error")
    var _raised2 = False
    try:
        _ = tm.mkReal("2/0000")
    except:
        _raised2 = True
    assert_true(_raised2, "expected an error")


