    assert_true(tm.mkRoundingMode(RoundingMode.ROUND_NEAREST_TIES_TO_EVEN).isRoundingModeValue())
    assert_false(tm.mkConst(tm.getRoundingModeSort()).isRoundingModeValue())


def test_get_rounding_mode_value() raises:
    var tm = TermManager()
    var _raised1 = False
    try:
        _ = tm.mkInteger(15).getRoundingModeValue()
    except:
        _raised1 = True
    assert_true(_raised1, "expected an error")
    assert_true((tm.mkRoundingMode(RoundingMode.ROUND_NEAREST_TIES_TO_EVEN).getRoundingModeValue() == RoundingMode.ROUND_NEAREST_TIES_TO_EVEN))
    assert_true((tm.mkRoundingMode(RoundingMode.ROUND_TOWARD_POSITIVE).getRoundingModeValue() == RoundingMode.ROUND_TOWARD_POSITIVE))
    assert_true((tm.mkRoundingMode(RoundingMode.ROUND_TOWARD_NEGATIVE).getRoundingModeValue() == RoundingMode.ROUND_TOWARD_NEGATIVE))
    assert_true((tm.mkRoundingMode(RoundingMode.ROUND_TOWARD_ZERO).getRoundingModeValue() == RoundingMode.ROUND_TOWARD_ZERO))
    assert_true((tm.mkRoundingMode(RoundingMode.ROUND_NEAREST_TIES_TO_AWAY).getRoundingModeValue() == RoundingMode.ROUND_NEAREST_TIES_TO_AWAY))


def test_get_tuple() raises:
    var tm = TermManager()
    var t1 = tm.mkInteger(15)
    var t2 = tm.mkReal(17, 25)
    var t3 = tm.mkString("abc")
    var tup = tm.mkTuple([t1, t2, t3])
    assert_true(tup.isTupleValue())
