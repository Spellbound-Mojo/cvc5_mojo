def test_get_set() raises:
    var tm = TermManager()
    var solver = Solver(tm)
    var s = tm.mkSetSort(tm.getIntegerSort())
    var i1 = tm.mkInteger(5)
    var i2 = tm.mkInteger(7)
    var s1 = tm.mkEmptySet(s)
    var s2 = tm.mkTerm(Kind.SET_SINGLETON, i1)
    var s3 = tm.mkTerm(Kind.SET_SINGLETON, i1)
    var s4 = tm.mkTerm(Kind.SET_SINGLETON, i2)
    var s5 = tm.mkTerm(Kind.SET_UNION, s2, tm.mkTerm(Kind.SET_UNION, s3, s4))
    assert_true(s1.isSetValue())
    assert_true(s2.isSetValue())
    assert_true(s3.isSetValue())
    assert_true(s4.isSetValue())
    assert_false(s5.isSetValue())
    s5 = solver.simplify(s5)
    assert_true(s5.isSetValue())
    assert_true(_set_equal[Term]([], s1.getSetValue()))
    assert_true(_set_equal[Term]([i1], s2.getSetValue()))
    assert_true(_set_equal[Term]([i1], s3.getSetValue()))
    assert_true(_set_equal[Term]([i2], s4.getSetValue()))
    assert_true(_set_equal[Term]([i1, i2], s5.getSetValue()))


def test_get_sequence() raises:
    var tm = TermManager()
    var solver = Solver(tm)
    var s = tm.mkSequenceSort(tm.getIntegerSort())
    var i1 = tm.mkInteger(5)
    var i2 = tm.mkInteger(7)
    var s1 = tm.mkEmptySequence(s)
    var s2 = tm.mkTerm(Kind.SEQ_UNIT, i1)
    var s3 = tm.mkTerm(Kind.SEQ_UNIT, i1)
    var s4 = tm.mkTerm(Kind.SEQ_UNIT, i2)
    var s5 = tm.mkTerm(Kind.SEQ_CONCAT, s2, tm.mkTerm(Kind.SEQ_CONCAT, s3, s4))
    assert_true(s1.isSequenceValue())
    assert_false(s2.isSequenceValue())
    assert_false(s3.isSequenceValue())
    assert_false(s4.isSequenceValue())
    assert_false(s5.isSequenceValue())
    s2 = solver.simplify(s2)
    s3 = solver.simplify(s3)
    s4 = solver.simplify(s4)
    s5 = solver.simplify(s5)
    assert_true((s1.getSequenceValue() == []))
    assert_true((s2.getSequenceValue() == [i1]))
    assert_true((s3.getSequenceValue() == [i1]))
    assert_true((s4.getSequenceValue() == [i2]))
    assert_true((s5.getSequenceValue() == [i1, i1, i2]))


def test_get_floating_point() raises:
    var tm = TermManager()
    var bvval = tm.mkBitVector(16, "0000110000000011", 2)
    var fp = tm.mkFloatingPoint(5, 11, bvval)
    assert_true(fp.isFloatingPointValue())
    assert_false(fp.isFloatingPointPosZero())
    assert_false(fp.isFloatingPointNegZero())
    assert_false(fp.isFloatingPointPosInf())
    assert_false(fp.isFloatingPointNegInf())
    assert_false(fp.isFloatingPointNaN())
    assert_true(((5, 11, bvval) == fp.getFloatingPointValue()))
    assert_true(tm.mkFloatingPointPosZero(5, 11).isFloatingPointPosZero())
    assert_true(tm.mkFloatingPointNegZero(5, 11).isFloatingPointNegZero())
    assert_true(tm.mkFloatingPointPosInf(5, 11).isFloatingPointPosInf())
    assert_true(tm.mkFloatingPointNegInf(5, 11).isFloatingPointNegInf())
    assert_true(tm.mkFloatingPointNaN(5, 11).isFloatingPointNaN())


def test_is_integer() raises:
    var tm = TermManager()
    var int1 = tm.mkInteger("-18446744073709551616")
    var int2 = tm.mkInteger("-18446744073709551615")
    var int3 = tm.mkInteger("-4294967296")
    var int4 = tm.mkInteger("-4294967295")
    var int5 = tm.mkInteger("-10")
    var int6 = tm.mkInteger("0")
    var int7 = tm.mkInteger("10")
    var int8 = tm.mkInteger("4294967295")
    var int9 = tm.mkInteger("4294967296")
    var int10 = tm.mkInteger("18446744073709551615")
    var int11 = tm.mkInteger("18446744073709551616")
    var int12 = tm.mkInteger("-0")
    var _raised1 = False
