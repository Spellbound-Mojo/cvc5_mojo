    except:
        _raised2 = True
    assert_true(_raised2, "expected an error")
    var _raised3 = False
    try:
        _ = tm.mkInteger("-1-")
    except:
        _raised3 = True
    assert_true(_raised3, "expected an error")
    var _raised4 = False
    try:
        _ = tm.mkInteger("0.0")
    except:
        _raised4 = True
    assert_true(_raised4, "expected an error")
    var _raised5 = False
    try:
        _ = tm.mkInteger("-0.1")
    except:
        _raised5 = True
    assert_true(_raised5, "expected an error")
    var _raised6 = False
    try:
        _ = tm.mkInteger("012")
    except:
        _raised6 = True
    assert_true(_raised6, "expected an error")
    var _raised7 = False
    try:
        _ = tm.mkInteger("0000")
    except:
        _raised7 = True
    assert_true(_raised7, "expected an error")
    var _raised8 = False
    try:
        _ = tm.mkInteger("-01")
    except:
        _raised8 = True
    assert_true(_raised8, "expected an error")
    var _raised9 = False
    try:
        _ = tm.mkInteger("-00")
    except:
        _raised9 = True
    assert_true(_raised9, "expected an error")
    assert_true(int1.isIntegerValue())
    assert_true(int2.isIntegerValue())
    assert_true(int3.isIntegerValue())
    assert_true(int4.isIntegerValue())
    assert_true(int5.isIntegerValue())
    assert_true(int6.isIntegerValue())
    assert_true(int7.isIntegerValue())
    assert_true(int8.isIntegerValue())
    assert_true(int9.isIntegerValue())
    assert_true(int10.isIntegerValue())
    assert_true(int11.isIntegerValue())
    assert_true((int1.getIntegerValue() == -18446744073709551616))
    assert_true((int2.getIntegerValue() == -18446744073709551615))
    assert_true((int3.getIntegerValue() == -4294967296))
    assert_true((int4.getIntegerValue() == -4294967295))
    assert_true((int5.getIntegerValue() == -10))
    assert_true((int6.getIntegerValue() == 0))
    assert_true((int7.getIntegerValue() == 10))
    assert_true((int8.getIntegerValue() == 4294967295))
    assert_true((int9.getIntegerValue() == 4294967296))
    assert_true((int10.getIntegerValue() == 18446744073709551615))
    assert_true((int11.getIntegerValue() == 18446744073709551616))
    assert_true((int1.getRealOrIntegerValueSign() == -1))
    assert_true((int6.getRealOrIntegerValueSign() == 0))
    assert_true((int7.getRealOrIntegerValueSign() == 1))


