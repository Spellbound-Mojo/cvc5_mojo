    assert_true((b3.getBitVectorValue(16) == "f"))
    assert_true((b4.getBitVectorValue(2) == "00001111"))
    assert_true((b4.getBitVectorValue(10) == "15"))
    assert_true((b4.getBitVectorValue(16) == "f"))
    assert_true((b5.getBitVectorValue(2) == "000001111"))
    assert_true((b5.getBitVectorValue(10) == "15"))
    assert_true((b5.getBitVectorValue(16) == "f"))
    assert_true((b6.getBitVectorValue(2) == "000001111"))
    assert_true((b6.getBitVectorValue(10) == "15"))
    assert_true((b6.getBitVectorValue(16) == "f"))
    assert_true((b7.getBitVectorValue(2) == "000001111"))
    assert_true((b7.getBitVectorValue(10) == "15"))
    assert_true((b7.getBitVectorValue(16) == "f"))


def test_const_array() raises:
    var tm = TermManager()
    var intsort = tm.getIntegerSort()
    var arrsort = tm.mkArraySort(intsort, intsort)
    var a = tm.mkConst(arrsort, "a")
    var one = tm.mkInteger(1)
    var two = tm.mkBitVector(2, 2)
    var iconst = tm.mkConst(intsort)
    var constarr = tm.mkConstArray(arrsort, one)
    var _raised1 = False
    try:
        _ = tm.mkConstArray(arrsort, two)
    except:
        _raised1 = True
    assert_true(_raised1, "expected an error")
    var _raised2 = False
    try:
        _ = tm.mkConstArray(arrsort, iconst)
    except:
        _raised2 = True
    assert_true(_raised2, "expected an error")
    assert_true((constarr.getKind() == Kind.CONST_ARRAY))
    assert_true((constarr.getConstArrayBase() == one))
    var _raised3 = False
    try:
        _ = a.getConstArrayBase()
    except:
        _raised3 = True
    assert_true(_raised3, "expected an error")
    arrsort = tm.mkArraySort(tm.getRealSort(), tm.getRealSort())
    var zero_array = tm.mkConstArray(arrsort, tm.mkReal(0))
    var stores = tm.mkTerm(Kind.STORE, zero_array, tm.mkReal(1), tm.mkReal(2))
    stores = tm.mkTerm(Kind.STORE, stores, tm.mkReal(2), tm.mkReal(3))
    stores = tm.mkTerm(Kind.STORE, stores, tm.mkReal(4), tm.mkReal(5))


