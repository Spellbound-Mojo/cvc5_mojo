"""cvc5's Python example `transcendentals.py`, translated to Mojo."""

from cvc5_mojo import Kind, Solver, TermManager


def main() raises:
    var tm = TermManager()
    var slv = Solver(tm)
    slv.setLogic("QF_NRAT")
    var real = tm.getRealSort()
    var x = tm.mkConst(real, "x")
    var y = tm.mkConst(real, "y")
    var two = tm.mkReal(2)
    var pi = tm.mkPi()
    var twopi = tm.mkTerm(Kind.MULT, two, pi)
    var ysq = tm.mkTerm(Kind.MULT, y, y)
    var sinx = tm.mkTerm(Kind.SINE, x)
    var x_gt_pi = tm.mkTerm(Kind.GT, x, pi)
    var x_lt_tpi = tm.mkTerm(Kind.LT, x, twopi)
    var ysq_lt_sinx = tm.mkTerm(Kind.LT, ysq, sinx)
    slv.assertFormula(x_gt_pi)
    slv.assertFormula(x_lt_tpi)
    slv.assertFormula(ysq_lt_sinx)
    print("cvc5 should report UNSAT")
    print("Result from cvc5 is:", slv.checkSat())
