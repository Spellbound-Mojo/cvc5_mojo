"""cvc5's Python example `sygus-fun.py`, translated to Mojo."""

from cvc5_mojo import Kind, Solver, Term, TermManager


def define_fun_to_string(f: Term, params: List[Term], body: Term) raises -> String:
    var sort = f.getSort()
    if sort.isFunction():
        sort = f.getSort().getFunctionCodomainSort()
    var result = (("(define-fun " + String(f)) + " (")
    for i in range(0, len(params)):
        if (i > 0):
            result += " "
        result += (((("(" + String(params[i])) + " ") + String(params[i].getSort())) + ")")
    result += ((((") " + String(sort)) + " ") + String(body)) + ")")
    return result


def print_synth_solutions(terms: List[Term], sols: List[Term]) raises:
    var result = "(\n"
    for i in range(0, len(terms)):
        var params = List[Term]()
        var body = sols[i]
        if (sols[i].getKind() == Kind.LAMBDA):
            for _item1 in sols[i][0]:
                params.append(_item1)
            body = sols[i][1]
        result += (("  " + define_fun_to_string(terms[i], params, body)) + "\n")
    result += ")"
    print(result)


def main() raises:
    var tm = TermManager()
    var slv = Solver(tm)
    slv.setOption("sygus", "true")
    slv.setOption("incremental", "false")
    slv.setLogic("LIA")
    var integer = tm.getIntegerSort()
    var boolean = tm.getBooleanSort()
    var x = tm.mkVar(integer, "x")
    var y = tm.mkVar(integer, "y")
    var start = tm.mkVar(integer, "Start")
    var start_bool = tm.mkVar(boolean, "StartBool")
    var zero = tm.mkInteger(0)
    var one = tm.mkInteger(1)
    var plus = tm.mkTerm(Kind.ADD, start, start)
    var minus = tm.mkTerm(Kind.SUB, start, start)
    var ite = tm.mkTerm(Kind.ITE, start_bool, start, start)
    var And = tm.mkTerm(Kind.AND, start_bool, start_bool)
    var Not = tm.mkTerm(Kind.NOT, start_bool)
    var leq = tm.mkTerm(Kind.LEQ, start, start)
    var g = slv.mkGrammar([x, y], [start, start_bool])
    g.addRules(start, [zero, one, x, y, plus, minus, ite])
    g.addRules(start_bool, [And, Not, leq])
    var max = slv.synthFun("max", [x, y], integer, g)
    var min = slv.synthFun("min", [x, y], integer)
    var varX = slv.declareSygusVar("x", integer)
    var varY = slv.declareSygusVar("y", integer)
    var max_x_y = tm.mkTerm(Kind.APPLY_UF, max, varX, varY)
    var min_x_y = tm.mkTerm(Kind.APPLY_UF, min, varX, varY)
    slv.addSygusConstraint(tm.mkTerm(Kind.GEQ, max_x_y, varX))
    slv.addSygusConstraint(tm.mkTerm(Kind.GEQ, max_x_y, varY))
    slv.addSygusConstraint(tm.mkTerm(Kind.OR, tm.mkTerm(Kind.EQUAL, max_x_y, varX), tm.mkTerm(Kind.EQUAL, max_x_y, varY)))
    slv.addSygusConstraint(tm.mkTerm(Kind.EQUAL, tm.mkTerm(Kind.ADD, max_x_y, min_x_y), tm.mkTerm(Kind.ADD, varX, varY)))
    if slv.checkSynth().hasSolution():
        var terms: List[type_of(max)] = [max, min]
        print_synth_solutions(terms, slv.getSynthSolutions(terms))
