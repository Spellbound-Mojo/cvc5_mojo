"""cvc5's Python example `floating_point.py`, translated to Mojo."""

from std.testing import assert_true

from cvc5_mojo import Kind, Result, RoundingMode, Solver, Term, TermManager


def _checked_sat(solver: Solver) raises -> Result:
    var result = solver.checkSat()
    if result.isSat():
        for assertion in solver.getAssertions():
            assert_true(solver.getValue(assertion).getBooleanValue(), "model violates an assertion")
    return result


def _checked_value(solver: Solver, term: Term) raises -> Term:
    var value = solver.getValue(term)
    assert_true(value.getSort() == term.getSort(), "model value has the wrong sort")
    var equal = solver.getTermManager().mkTerm(Kind.EQUAL, term, value)
    assert_true(solver.getValue(equal).getBooleanValue(), "model value disagrees with the evaluated term")
    return value


def main() raises:
    var tm = TermManager()
    var slv = Solver(tm)
    slv.setOption("produce-models", "true")
    slv.setLogic("QF_FP")
    var fp32 = tm.mkFloatingPointSort(8, 24)
    var rm = tm.mkRoundingMode(RoundingMode.ROUND_NEAREST_TIES_TO_EVEN)
    var a = tm.mkConst(fp32, "a")
    var b = tm.mkConst(fp32, "b")
    var c = tm.mkConst(fp32, "c")
    var d = tm.mkConst(fp32, "d")
    var e = tm.mkConst(fp32, "e")
    print("Show that fused multiplication and addition `(fp.fma RM a b c)`")
    print("is different from `(fp.add RM (fp.mul a b) c)`:")
    slv.push()
    var fma = tm.mkTerm(Kind.FLOATINGPOINT_FMA, rm, a, b, c)
    var mul = tm.mkTerm(Kind.FLOATINGPOINT_MULT, rm, a, b)
    var add = tm.mkTerm(Kind.FLOATINGPOINT_ADD, rm, mul, c)
    slv.assertFormula(tm.mkTerm(Kind.DISTINCT, fma, add))
    print("Expect SAT.")
    print("cvc5:", _checked_sat(slv))
    print(String("Value of `a`: ", _checked_value(slv, a)))
    print(String("Value of `b`: ", _checked_value(slv, b)))
    print(String("Value of `c`: ", _checked_value(slv, c)))
    print(String("Value of `(fp.fma RNE a b c)`: ", _checked_value(slv, fma)))
    print(String("Value of `(fp.add RNE (fp.mul a b) c)`: ", _checked_value(slv, add)))
    print()
    slv.pop()
    print("Show that floating-point addition is not associative:")
    print("(a + (b + c)) != ((a + b) + c)")
    slv.push()
    slv.assertFormula(tm.mkTerm(Kind.DISTINCT, tm.mkTerm(Kind.FLOATINGPOINT_ADD, rm, a, tm.mkTerm(Kind.FLOATINGPOINT_ADD, rm, b, c)), tm.mkTerm(Kind.FLOATINGPOINT_ADD, rm, tm.mkTerm(Kind.FLOATINGPOINT_ADD, rm, a, b), c)))
    print("Expect SAT.")
    print("cvc5:", _checked_sat(slv))
    print(String("Value of `a`: ", _checked_value(slv, a)))
    print(String("Value of `b`: ", _checked_value(slv, b)))
    print(String("Value of `c`: ", _checked_value(slv, c)))
    print()
    print("Now, restrict `a` to be either NaN or positive infinity:")
    var nan = tm.mkFloatingPointNaN(8, 24)
    var inf = tm.mkFloatingPointPosInf(8, 24)
    slv.assertFormula(tm.mkTerm(Kind.OR, tm.mkTerm(Kind.EQUAL, a, inf), tm.mkTerm(Kind.EQUAL, a, nan)))
    print("Expect SAT.")
    print("cvc5:", _checked_sat(slv))
    print(String("Value of `a`: ", _checked_value(slv, a)))
    print(String("Value of `b`: ", _checked_value(slv, b)))
    print(String("Value of `c`: ", _checked_value(slv, c)))
    print()
    slv.pop(1)
    print("Now, try to find a (normal) floating-point number that rounds")
    print("to different integer values for different rounding modes:")
    slv.push()
    var rtp = tm.mkRoundingMode(RoundingMode.ROUND_TOWARD_POSITIVE)
    var rtn = tm.mkRoundingMode(RoundingMode.ROUND_TOWARD_NEGATIVE)
    var op = tm.mkOp(Kind.FLOATINGPOINT_TO_UBV, 16)
    var lhs = tm.mkTerm(op, rtp, d)
    var rhs = tm.mkTerm(op, rtn, d)
    slv.assertFormula(tm.mkTerm(Kind.FLOATINGPOINT_IS_NORMAL, d))
    slv.assertFormula(tm.mkTerm(Kind.NOT, tm.mkTerm(Kind.EQUAL, lhs, rhs)))
    print("Expect SAT.")
    print("cvc5:", _checked_sat(slv))
    print("Get value of `d` as floating-point, bit-vector and real:")
    var val = _checked_value(slv, d)
    print(String("Value of `d`: ", val))
    print(String("Value of `((_ fp.to_ubv 16) RTP d)`: ", _checked_value(slv, lhs)))
    print(String("Value of `((_ fp.to_ubv 16) RTN d)`: ", _checked_value(slv, rhs)))
    print(String("Value of `(fp.to_real d)`: ", _checked_value(slv, tm.mkTerm(Kind.FLOATINGPOINT_TO_REAL, val))))
    print()
    slv.pop()
    print("Finally, try to find a floating-point number between positive")
    print("zero and the smallest positive floating-point number:")
    var zero = tm.mkFloatingPointPosZero(8, 24)
    var smallest = tm.mkFloatingPoint(8, 24, tm.mkBitVector(32, 1))
    slv.assertFormula(tm.mkTerm(Kind.AND, tm.mkTerm(Kind.FLOATINGPOINT_LT, zero, e), tm.mkTerm(Kind.FLOATINGPOINT_LT, e, smallest)))
    print("Expect UNSAT.")
    print("cvc5:", _checked_sat(slv))
