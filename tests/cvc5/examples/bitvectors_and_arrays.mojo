"""cvc5's Python example `bitvectors_and_arrays.py`, translated to Mojo."""

from std.math import ceil, log

from cvc5_mojo import Kind, Solver, Term, TermManager


def main() raises:
    var tm = TermManager()
    var slv = Solver(tm)
    slv.setOption("produce-models", "true")
    slv.setOption("output-language", "smtlib")
    slv.setLogic("QF_ABV")
    var k = 4
    var index_size = Int(ceil(Float64((log(Float64(k)) / log(Float64(2))))))
    var elementSort = tm.mkBitVectorSort(32)
    var indexSort = tm.mkBitVectorSort(index_size)
    var arraySort = tm.mkArraySort(indexSort, elementSort)
    var current_array = tm.mkConst(arraySort, "current_array")
    var zero = tm.mkBitVector(index_size, 0)
    var constarr0 = tm.mkConstArray(arraySort, tm.mkBitVector(32, 0))
    var current_array0 = tm.mkTerm(Kind.SELECT, current_array, zero)
    var current_array0_gt_0 = tm.mkTerm(Kind.BITVECTOR_SGT, current_array0, tm.mkBitVector(32, 0))
    slv.assertFormula(current_array0_gt_0)
    var index = tm.mkBitVector(index_size, 0)
    var old_current = tm.mkTerm(Kind.SELECT, current_array, index)
    var two = tm.mkBitVector(32, 2)
    var assertions = List[Term]()
    for i in range(1, k):
        index = tm.mkBitVector(index_size, i)
        var new_current = tm.mkTerm(Kind.BITVECTOR_MULT, two, old_current)
        current_array = tm.mkTerm(Kind.STORE, current_array, index, new_current)
        var current_slt_new_current = tm.mkTerm(Kind.BITVECTOR_SLT, old_current, new_current)
        assertions.append(current_slt_new_current)
        old_current = tm.mkTerm(Kind.SELECT, current_array, index)
    var query = tm.mkTerm(Kind.NOT, tm.mkTerm(Kind.AND, assertions))
    print(String("Asserting ", query, " to cvc5"))
    slv.assertFormula(query)
    print("Expect sat.")
    print("cvc5:", slv.checkSatAssuming(tm.mkTrue()))
    print("The satisfying model is: ")
    print(" current_array =", slv.getValue(current_array))
    print(" current_array[0]", slv.getValue(current_array0))
