"""cvc5's Python example `extract.py`, translated to Mojo."""

from cvc5_mojo import Kind, Solver, TermManager


def main() raises:
    var tm = TermManager()
    var slv = Solver(tm)
    slv.setLogic("QF_BV")
    var bitvector32 = tm.mkBitVectorSort(32)
    var x = tm.mkConst(bitvector32, "a")
    var ext_31_1 = tm.mkOp(Kind.BITVECTOR_EXTRACT, 31, 1)
    var x_31_1 = tm.mkTerm(ext_31_1, x)
    var ext_30_0 = tm.mkOp(Kind.BITVECTOR_EXTRACT, 30, 0)
    var x_30_0 = tm.mkTerm(ext_30_0, x)
    var ext_31_31 = tm.mkOp(Kind.BITVECTOR_EXTRACT, 31, 31)
    var x_31_31 = tm.mkTerm(ext_31_31, x)
    var ext_0_0 = tm.mkOp(Kind.BITVECTOR_EXTRACT, 0, 0)
    var x_0_0 = tm.mkTerm(ext_0_0, x)
    var eq = tm.mkTerm(Kind.EQUAL, x_31_1, x_30_0)
    print("Asserting:", eq)
    slv.assertFormula(eq)
    var eq2 = tm.mkTerm(Kind.EQUAL, x_31_31, x_0_0)
    print("Check sat assuming:", eq2.notTerm())
    print("Expect UNSAT")
    print("cvc5:", slv.checkSatAssuming(eq2.notTerm()))
