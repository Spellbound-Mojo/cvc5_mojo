"""cvc5's Python example `bags.py`, translated to Mojo."""

from cvc5_mojo import Kind, Solver, TermManager


def main() raises:
    var tm = TermManager()
    var slv = Solver(tm)
    slv.setLogic("ALL")
    slv.setOption("produce-models", "true")
    slv.setOption("incremental", "true")
    var bag = tm.mkBagSort(tm.getStringSort())
    var A = tm.mkConst(bag, "A")
    var B = tm.mkConst(bag, "B")
    var C = tm.mkConst(bag, "C")
    var x = tm.mkConst(tm.getStringSort(), "x")
    var intersectionAC = tm.mkTerm(Kind.BAG_INTER_MIN, A, C)
    var intersectionBC = tm.mkTerm(Kind.BAG_INTER_MIN, B, C)
    var unionDisjointAB = tm.mkTerm(Kind.BAG_UNION_DISJOINT, A, B)
    var lhs = tm.mkTerm(Kind.BAG_INTER_MIN, unionDisjointAB, C)
    var rhs = tm.mkTerm(Kind.BAG_UNION_DISJOINT, intersectionAC, intersectionBC)
    var guess = tm.mkTerm(Kind.EQUAL, lhs, rhs)
    print(String("cvc5 reports: ", guess.notTerm(), " is ", slv.checkSatAssuming(guess.notTerm())))
    print(String(A, ": ", slv.getValue(A)))
    print(String(B, ": ", slv.getValue(B)))
    print(String(C, ": ", slv.getValue(C)))
    print(String(lhs, ": ", slv.getValue(lhs)))
    print(String(rhs, ": ", slv.getValue(rhs)))
    var unionMaxAB = tm.mkTerm(Kind.BAG_UNION_MAX, A, B)
    lhs = tm.mkTerm(Kind.BAG_INTER_MIN, unionMaxAB, C)
    rhs = tm.mkTerm(Kind.BAG_UNION_MAX, intersectionAC, intersectionBC)
    var theorem = tm.mkTerm(Kind.EQUAL, lhs, rhs)
    print(String("cvc5 reports: ", theorem.notTerm(), " is ", slv.checkSatAssuming(theorem.notTerm()), "."))
    var emptybag = tm.mkEmptyBag(bag)
    theorem = tm.mkTerm(Kind.BAG_SUBBAG, emptybag, A)
    print(String("cvc5 reports: ", theorem.notTerm(), " is ", slv.checkSatAssuming(theorem.notTerm()), "."))
    var one = tm.mkInteger(1)
    var two = tm.mkInteger(2)
    var three = tm.mkInteger(3)
    var four = tm.mkInteger(4)
    var a = tm.mkString("a")
    var b = tm.mkString("b")
    var c = tm.mkString("c")
    var bag_a_2 = tm.mkTerm(Kind.BAG_MAKE, a, two)
    var bag_b_3 = tm.mkTerm(Kind.BAG_MAKE, b, three)
    var bag_b_1 = tm.mkTerm(Kind.BAG_MAKE, b, one)
    var bag_c_2 = tm.mkTerm(Kind.BAG_MAKE, c, two)
    var bag_a_2_b_3 = tm.mkTerm(Kind.BAG_UNION_DISJOINT, bag_a_2, bag_b_3)
    var bag_b_1_c_2 = tm.mkTerm(Kind.BAG_UNION_DISJOINT, bag_b_1, bag_c_2)
    var UnionDisjoint = tm.mkTerm(Kind.BAG_UNION_DISJOINT, bag_a_2_b_3, bag_b_1_c_2)
    var count_x = tm.mkTerm(Kind.BAG_COUNT, x, UnionDisjoint)
    var e = tm.mkTerm(Kind.EQUAL, four, count_x)
    var result = slv.checkSatAssuming(e)
    print(String("cvc5 reports: ", e, " is ", result, "."))
    if result.isSat():
        print(String(x, ": ", slv.getValue(x), " "))
