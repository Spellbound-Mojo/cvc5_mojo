from cvc5_mojo import Kind, Solver, TermManager


def main() raises:
    var tm = TermManager()
    var slv = Solver(tm)
    slv.setLogic("QF_BV")
    var bitvector32 = tm.mkBitVectorSort(32)
    var x = tm.mkConst(bitvector32, "x")
    var a = tm.mkConst(bitvector32, "a")
    var b = tm.mkConst(bitvector32, "b")
    var x_eq_a = tm.mkTerm(Kind.EQUAL, x, a)
    var x_eq_b = tm.mkTerm(Kind.EQUAL, x, b)
    var assumption = tm.mkTerm(Kind.OR, x_eq_a, x_eq_b)
    slv.assertFormula(assumption)
    var new_x = tm.mkConst(bitvector32, "new_x")
    var new_x_ = tm.mkConst(bitvector32, "new_x_")
    var ite = tm.mkTerm(Kind.ITE, x_eq_a, b, a)
    var assignment0 = tm.mkTerm(Kind.EQUAL, new_x, ite)
    print(String("Asserting ", assignment0, " to cvc5"))
    slv.assertFormula(assignment0)
    print("Pushing a new context.")
    slv.push()
    var a_xor_b_xor_x = tm.mkTerm(Kind.BITVECTOR_XOR, a, b, x)
    var assignment1 = tm.mkTerm(Kind.EQUAL, new_x_, a_xor_b_xor_x)
    print(String("Asserting ", assignment1, " to cvc5"))
    slv.assertFormula(assignment1)
    var new_x_eq_new_x_ = tm.mkTerm(Kind.EQUAL, new_x, new_x_)
    print("Checking sat assuming:", new_x_eq_new_x_.notTerm())
    print("Expect UNSAT.")
    print("cvc5:", slv.checkSatAssuming(new_x_eq_new_x_.notTerm()))
    print("Popping context.")
    slv.pop()
    var a_plus_b = tm.mkTerm(Kind.BITVECTOR_ADD, a, b)
    var a_plus_b_minus_x = tm.mkTerm(Kind.BITVECTOR_SUB, a_plus_b, x)
    var assignment2 = tm.mkTerm(Kind.EQUAL, new_x_, a_plus_b_minus_x)
    print(String("Asserting ", assignment2, " to cvc5"))
    slv.assertFormula(assignment2)
    print("Checking sat assuming:", new_x_eq_new_x_.notTerm())
    print("Expect UNSAT.")
    print("cvc5:", slv.checkSatAssuming(new_x_eq_new_x_.notTerm()))
    var x_neq_x = tm.mkTerm(Kind.EQUAL, x, x).notTerm()
    var query = tm.mkTerm(Kind.AND, new_x_eq_new_x_, x_neq_x)
    print("Check sat assuming: ", query.notTerm())
    print("Expect SAT.")
    print("cvc5:", slv.checkSatAssuming(query.notTerm()))
    var extract_op = tm.mkOp(Kind.BITVECTOR_EXTRACT, 0, 0)
    var lsb_of_a = tm.mkTerm(extract_op, a)
    print(String("Sort of ", lsb_of_a, " is ", lsb_of_a.getSort()))
    var a_odd = tm.mkTerm(Kind.EQUAL, lsb_of_a, tm.mkBitVector(1, 1))
    print("Assert", a_odd)
    print("Check satisifiability")
    slv.assertFormula(a_odd)
    print("Expect sat")
    print("cvc5:", slv.checkSat())
