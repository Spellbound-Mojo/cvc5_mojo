"""cvc5's Python example `sygus-inv.py`, translated to Mojo."""

from cvc5_mojo import Kind, Solver, Term, TermManager


def define_fun_to_string(f: Term, params: List[Term], body: Term) raises -> String:
    var sort = f.getSort()
    if sort.isFunction():
        sort = f.getSort().getFunctionCodomainSort()
    var result = (("(define-fun " + String(f)) + " (")
    for i in range(0, len(params)):
        if (i > 0):
            result += " "
        result += (((("(" + String(params[i])) + " ") + String(params[i].getSort())) + ")")
    result += ((((") " + String(sort)) + " ") + String(body)) + ")")
    return result


def print_synth_solutions(terms: List[Term], sols: List[Term]) raises:
    var result = "(\n"
    for i in range(0, len(terms)):
        var params = List[Term]()
        var body = sols[i]
        if (sols[i].getKind() == Kind.LAMBDA):
            for _item1 in sols[i][0]:
                params.append(_item1)
            body = sols[i][1]
        result += (("  " + define_fun_to_string(terms[i], params, body)) + "\n")
    result += ")"
    print(result)


def main() raises:
    var tm = TermManager()
    var slv = Solver(tm)
    slv.setOption("sygus", "true")
    slv.setOption("incremental", "false")
    slv.setLogic("LIA")
    var integer = tm.getIntegerSort()
    var boolean = tm.getBooleanSort()
    var zero = tm.mkInteger(0)
    var one = tm.mkInteger(1)
    var ten = tm.mkInteger(10)
    var x = tm.mkVar(integer, "x")
    var xp = tm.mkVar(integer, "xp")
    var ite = tm.mkTerm(Kind.ITE, tm.mkTerm(Kind.LT, x, ten), tm.mkTerm(Kind.EQUAL, xp, tm.mkTerm(Kind.ADD, x, one)), tm.mkTerm(Kind.EQUAL, xp, x))
    var pre_f = slv.defineFun("pre-f", [x], boolean, tm.mkTerm(Kind.EQUAL, x, zero))
    var trans_f = slv.defineFun("trans-f", [x, xp], boolean, ite)
    var post_f = slv.defineFun("post-f", [x], boolean, tm.mkTerm(Kind.LEQ, x, ten))
    var inv_f = slv.synthFun("inv-f", [x], boolean)
    slv.addSygusInvConstraint(inv_f, pre_f, trans_f, post_f)
    if slv.checkSynth().hasSolution():
        var terms: List[type_of(inv_f)] = [inv_f]
        print_synth_solutions(terms, slv.getSynthSolutions(terms))
