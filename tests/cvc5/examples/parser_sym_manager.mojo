"""cvc5's Python example `parser_sym_manager.py`, translated to Mojo."""

from cvc5_mojo import InputLanguage, InputParser, Solver, SymbolManager, TermManager


def main() raises:
    var tm = TermManager()
    var slv = Solver(tm)
    var sm = SymbolManager(tm)
    var parser = InputParser(slv, sm)
    var input = "\n        (set-logic QF_LIA)\n        (declare-fun a () Int)\n        (declare-fun b () Int)\n        (declare-fun c () Bool)\n    "
    parser.setStringInput(InputLanguage.SMT_LIB_2_6, input, "MyInput")
    while True:
        var cmd = parser.nextCommand()
        if cmd.isNull():
            break
        print(String("Executing command ", cmd))
        print(cmd.invoke(slv, sm), end="")
    print("Finished parsing commands")
    var parser2 = InputParser(slv, sm)
    parser2.setIncrementalStringInput(InputLanguage.SMT_LIB_2_6, "MyInput2")
    var input2 = "\n        (+ a b)\n        (- a 10)\n        (>= 0 45)\n        (and c c)\n        true\n    "
    parser2.appendIncrementalStringInput(input2)
    var t = parser2.nextTerm()
    while not t.isNull():
        print(String("Parsed term: ", t))
        t = parser2.nextTerm()
    print("Finished parsing terms")
