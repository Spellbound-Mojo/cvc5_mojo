"""cvc5's Python example `sequences.py`, translated to Mojo."""

from cvc5_mojo import Kind, Solver, TermManager


def main() raises:
    var tm = TermManager()
    var slv = Solver(tm)
    slv.setLogic("QF_SLIA")
    slv.setOption("produce-models", "true")
    slv.setOption("strings-exp", "true")
    slv.setOption("output-language", "smt2")
    var int_seq = tm.mkSequenceSort(tm.getIntegerSort())
    var x = tm.mkConst(int_seq, "x")
    var y = tm.mkConst(int_seq, "y")
    var empty = tm.mkEmptySequence(tm.getIntegerSort())
    var concat = tm.mkTerm(Kind.SEQ_CONCAT, x, y, empty)
    var concat_len = tm.mkTerm(Kind.SEQ_LENGTH, concat)
    var formula1 = tm.mkTerm(Kind.GT, concat_len, tm.mkInteger(1))
    var unit = tm.mkTerm(Kind.SEQ_UNIT, tm.mkInteger(1))
    var formula2 = tm.mkTerm(Kind.EQUAL, x, unit)
    var q = tm.mkTerm(Kind.AND, formula1, formula2)
    var result = slv.checkSatAssuming(q)
    print("cvc5 reports:", q, "is", result)
    if True:  # `result`, a `Result`, is true in Python
        print(String("x = ", slv.getValue(x)))
        print(String("y = ", slv.getValue(y)))
