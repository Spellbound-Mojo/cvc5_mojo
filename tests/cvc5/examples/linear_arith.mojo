"""cvc5's Python example `linear_arith.py`, translated to Mojo."""

from cvc5_mojo import Kind, Solver, TermManager


def main() raises:
    var tm = TermManager()
    var slv = Solver(tm)
    slv.setLogic("QF_LIRA")
    var real = tm.getRealSort()
    var integer = tm.getIntegerSort()
    var x = tm.mkConst(integer, "x")
    var y = tm.mkConst(real, "y")
    var three = tm.mkInteger(3)
    var neg2 = tm.mkInteger(-2)
    var two_thirds = tm.mkReal(2, 3)
    var three_y = tm.mkTerm(Kind.MULT, three, y)
    var diff = tm.mkTerm(Kind.SUB, y, x)
    var x_geq_3y = tm.mkTerm(Kind.GEQ, x, three_y)
    var x_leq_y = tm.mkTerm(Kind.LEQ, x, y)
    var neg2_lt_x = tm.mkTerm(Kind.LT, neg2, x)
    var assertions = tm.mkTerm(Kind.AND, x_geq_3y, x_leq_y, neg2_lt_x)
    print("Given the assertions", assertions)
    slv.assertFormula(assertions)
    slv.push()
    var diff_leq_two_thirds = tm.mkTerm(Kind.LEQ, diff, two_thirds)
    print("Prove that", diff_leq_two_thirds, "with cvc5")
    print("cvc5 should report UNSAT")
    print("Result from cvc5 is:", slv.checkSatAssuming(diff_leq_two_thirds.notTerm()))
    slv.pop()
    print()
    slv.push()
    var diff_is_two_thirds = tm.mkTerm(Kind.EQUAL, diff, two_thirds)
    slv.assertFormula(diff_is_two_thirds)
    print("Show that the assertions are consistent with\n", diff_is_two_thirds, "with cvc5")
    print("cvc5 should report SAT")
    print("Result from cvc5 is:", slv.checkSat())
    slv.pop()
