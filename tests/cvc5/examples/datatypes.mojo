"""cvc5's Python example `datatypes.py`, translated to Mojo."""

from cvc5_mojo import Kind, Solver, Sort, TermManager


def test(slv: Solver, consListSort: Sort) raises:
    var tm = slv.getTermManager()
    var consList = consListSort.getDatatype()
    var t = tm.mkTerm(Kind.APPLY_CONSTRUCTOR, consList.getConstructor("cons").getTerm(), tm.mkInteger(0), tm.mkTerm(Kind.APPLY_CONSTRUCTOR, consList.getConstructor("nil").getTerm()))
    print(String("t is ", t, "\nsort of cons is ", consList.getConstructor("cons").getTerm().getSort(), "\n sort of nil is ", consList.getConstructor("nil").getTerm().getSort()))
    var t2 = tm.mkTerm(Kind.APPLY_SELECTOR, consList["cons"].getSelector("head").getTerm(), t)
    print(String("t2 is ", t2, "\nsimplify(t2) is ", slv.simplify(t2), "\n\n"))
    for i in consList:
        print("ctor:", i)
        for j in i:
            print(" + args:", j)
        print()
    var t_is_cons = tm.mkTerm(Kind.APPLY_TESTER, consList["cons"].getTesterTerm(), t)
    print(String("t_is_cons is ", t_is_cons, "\n\n"))
    slv.assertFormula(t_is_cons)
    var t_updated = tm.mkTerm(Kind.APPLY_UPDATER, consList["cons"]["head"].getUpdaterTerm(), t, tm.mkInteger(1))
    print(String("t_updated is ", t_updated, "\n\n"))
    slv.assertFormula(tm.mkTerm(Kind.DISTINCT, t, t_updated))
    var sort = tm.mkParamSort("T")
    var paramConsListSpec = tm.mkDatatypeDecl("paramlist", [sort])
    var paramCons = tm.mkDatatypeConstructorDecl("cons")
    var paramNil = tm.mkDatatypeConstructorDecl("nil")
    paramCons.addSelector("head", sort)
    paramCons.addSelectorSelf("tail")
    paramConsListSpec.addConstructor(paramCons)
    paramConsListSpec.addConstructor(paramNil)
    var paramConsListSort = tm.mkDatatypeSort(paramConsListSpec)
    var paramConsIntListSort = paramConsListSort.instantiate([tm.getIntegerSort()])
    var paramConsList = paramConsListSort.getDatatype()
    var a = tm.mkConst(paramConsIntListSort, "a")
    print(String("term ", a, " is of sort ", a.getSort()))
    var head_a = tm.mkTerm(Kind.APPLY_SELECTOR, paramConsList["cons"].getSelector("head").getTerm(), a)
    print(String("head_a is ", head_a, " of sort ", head_a.getSort()))
    print("sort of cons is", paramConsList.getConstructor("cons").getTerm().getSort())
    var assertion = tm.mkTerm(Kind.GT, head_a, tm.mkInteger(50))
    print("Assert", assertion)
    slv.assertFormula(assertion)
    print("Expect sat.")
    print("cvc5:", slv.checkSat())


def main() raises:
    var tm = TermManager()
    var slv = Solver(tm)
    var consListSpec = tm.mkDatatypeDecl("list")
    var cons = tm.mkDatatypeConstructorDecl("cons")
    cons.addSelector("head", tm.getIntegerSort())
    cons.addSelectorSelf("tail")
    consListSpec.addConstructor(cons)
    var nil = tm.mkDatatypeConstructorDecl("nil")
    consListSpec.addConstructor(nil)
    print(String("spec is ", consListSpec))
    var consListSort = tm.mkDatatypeSort(consListSpec)
    test(slv, consListSort)
    print("### Alternatively, use declareDatatype")
    var cons2 = tm.mkDatatypeConstructorDecl("cons")
    cons2.addSelector("head", tm.getIntegerSort())
    cons2.addSelectorSelf("tail")
    var nil2 = tm.mkDatatypeConstructorDecl("nil")
    var consListSort2 = slv.declareDatatype("list2", cons2, nil2)
    test(slv, consListSort2)
