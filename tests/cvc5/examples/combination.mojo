"""cvc5's Python example `combination.py`, translated to Mojo."""

from cvc5_mojo import Kind, Solver, Term, TermManager


def prefixPrintGetValue(slv: Solver, t: Term, level: Int = 0) raises:
    print(String("slv.getValue(", t, "): ", slv.getValue(t)))
    for c in t:
        prefixPrintGetValue(slv, c, (level + 1))


def main() raises:
    var tm = TermManager()
    var slv = Solver(tm)
    slv.setOption("produce-models", "true")
    slv.setOption("dag-thresh", "0")
    slv.setOption("output-language", "smt2")
    slv.setLogic("QF_UFLIRA")
    var u = tm.mkUninterpretedSort("u")
    var integer = tm.getIntegerSort()
    var boolean = tm.getBooleanSort()
    var uToInt = tm.mkFunctionSort(u, integer)
    var intPred = tm.mkFunctionSort(integer, boolean)
    var x = tm.mkConst(u, "x")
    var y = tm.mkConst(u, "y")
    var f = tm.mkConst(uToInt, "f")
    var p = tm.mkConst(intPred, "p")
    var zero = tm.mkInteger(0)
    var one = tm.mkInteger(1)
    var f_x = tm.mkTerm(Kind.APPLY_UF, f, x)
    var f_y = tm.mkTerm(Kind.APPLY_UF, f, y)
    var sum_ = tm.mkTerm(Kind.ADD, f_x, f_y)
    var p_0 = tm.mkTerm(Kind.APPLY_UF, p, zero)
    var p_f_y = tm.mkTerm(Kind.APPLY_UF, p, f_y)
    var assertions = tm.mkTerm(Kind.AND, tm.mkTerm(Kind.LEQ, zero, f_x), tm.mkTerm(Kind.LEQ, zero, f_y), tm.mkTerm(Kind.LEQ, sum_, one), p_0.notTerm(), p_f_y)
    slv.assertFormula(assertions)
    print("Given the following assertions:", assertions, "\n")
    print("Prove x /= y is entailed.\ncvc5: ", slv.checkSatAssuming(tm.mkTerm(Kind.EQUAL, x, y)), "\n")
    print("Call checkSat to show that the assertions are satisfiable")
    print("cvc5:", slv.checkSat(), "\n")
    print("Call slv.getValue(...) on terms of interest")
    print(String("slv.getValue(", f_x, "): ", slv.getValue(f_x)))
    print(String("slv.getValue(", f_y, "): ", slv.getValue(f_y)))
    print(String("slv.getValue(", sum_, "): ", slv.getValue(sum_)))
    print(String("slv.getValue(", p_0, "): ", slv.getValue(p_0)))
    print(String("slv.getValue(", p_f_y, "): ", slv.getValue(p_f_y)), "\n")
    print("Alternatively, iterate over assertions and call slv.getValue(...) on all terms")
    prefixPrintGetValue(slv, assertions)
    print()
    print("You can also use nested loops to iterate over terms")
    for a in assertions:
        print("term:", a)
        for t in a:
            print(" + child: ", t)
    print()
