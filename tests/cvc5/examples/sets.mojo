    var intersectionBC = tm.mkTerm(Kind.SET_INTER, B, C)
    var rhs = tm.mkTerm(Kind.SET_UNION, intersectionAC, intersectionBC)
    var theorem = tm.mkTerm(Kind.EQUAL, lhs, rhs)
    print(String("cvc5 reports: ", theorem.notTerm(), " is ", slv.checkSatAssuming(theorem.notTerm())))
