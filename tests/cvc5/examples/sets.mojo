    var emptyset = tm.mkEmptySet(set_)
    theorem = tm.mkTerm(Kind.SET_SUBSET, emptyset, A)
    print(String("cvc5 reports: ", theorem.notTerm(), " is ", slv.checkSatAssuming(theorem.notTerm())))
    var one = tm.mkInteger(1)
    var two = tm.mkInteger(2)
    var three = tm.mkInteger(3)
    var singleton_one = tm.mkTerm(Kind.SET_SINGLETON, one)
    var singleton_two = tm.mkTerm(Kind.SET_SINGLETON, two)
    var singleton_three = tm.mkTerm(Kind.SET_SINGLETON, three)
    var one_two = tm.mkTerm(Kind.SET_UNION, singleton_one, singleton_two)
    var two_three = tm.mkTerm(Kind.SET_UNION, singleton_two, singleton_three)
    var intersection = tm.mkTerm(Kind.SET_INTER, one_two, two_three)
    var x = tm.mkConst(integer, "x")
