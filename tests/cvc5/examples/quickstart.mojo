"""cvc5's Python example `quickstart.py`, translated to Mojo."""

from cvc5_mojo import Kind, Solver, TermManager


def main() raises:
    var tm = TermManager()
    var solver = Solver(tm)
    solver.setOption("produce-models", "true")
    solver.setOption("produce-unsat-cores", "true")
    solver.setLogic("ALL")
    var realSort = tm.getRealSort()
    var intSort = tm.getIntegerSort()
    var x = tm.mkConst(realSort, "x")
    var y = tm.mkConst(realSort, "y")
    var a = tm.mkConst(intSort, "a")
    var b = tm.mkConst(intSort, "b")
    var zero = tm.mkReal(0)
    var one = tm.mkReal(1)
    var xPlusY = tm.mkTerm(Kind.ADD, x, y)
    var constraint1 = tm.mkTerm(Kind.LT, zero, x)
    var constraint2 = tm.mkTerm(Kind.LT, zero, y)
    var constraint3 = tm.mkTerm(Kind.LT, xPlusY, one)
    var constraint4 = tm.mkTerm(Kind.LEQ, x, y)
    solver.assertFormula(constraint1)
    solver.assertFormula(constraint2)
    solver.assertFormula(constraint3)
    solver.assertFormula(constraint4)
    var r1 = solver.checkSat()
    print("expected: sat")
    print("result: ", r1)
    var xVal = solver.getValue(x)
    var yVal = solver.getValue(y)
    var xMinusY = tm.mkTerm(Kind.SUB, x, y)
    var xMinusYVal = solver.getValue(xMinusY)
    var xPy = xVal.getRealValue()
    var yPy = yVal.getRealValue()
    var xMinusYPy = xMinusYVal.getRealValue()
    print("value for x: ", xPy)
    print("value for y: ", yPy)
    print("value for x - y: ", xMinusYPy)
    var xMinusYComputed = (xPy - yPy)
    if (xMinusYComputed == xMinusYPy):
        print("computed correctly")
    else:
        print("computed incorrectly")
    var xStr = String(xPy)
    var yStr = String(yPy)
    var xMinusYStr = String(xMinusYPy)
    solver.resetAssertions()
    solver.assertFormula(tm.mkTerm(Kind.LT, tm.mkInteger(0), a))
    solver.assertFormula(tm.mkTerm(Kind.LT, tm.mkInteger(0), b))
    solver.assertFormula(tm.mkTerm(Kind.LT, tm.mkTerm(Kind.ADD, a, b), tm.mkInteger(1)))
    solver.assertFormula(tm.mkTerm(Kind.LEQ, a, b))
    var r2 = solver.checkSat()
    print("expected: unsat")
    print("result:", r2)
    var unsatCore = solver.getUnsatCore()
    print("unsat core size:", len(unsatCore))
    print("unsat core:", unsatCore)
