"""cvc5's Python example `relations.py`, translated to Mojo."""

from cvc5_mojo import Kind, Solver, TermManager


def main() raises:
    var tm = TermManager()
    var solver = Solver(tm)
    solver.setLogic("ALL")
    solver.setOption("produce-models", "true")
    solver.setOption("finite-model-find", "true")
    solver.setOption("sets-exp", "true")
    var integer = tm.getIntegerSort()
    var set_ = tm.mkSetSort(integer)
    var personSort = tm.mkUninterpretedSort("Person")
    var tupleArity1 = tm.mkTupleSort(personSort)
    var relationArity1 = tm.mkSetSort(tupleArity1)
    var tupleArity2 = tm.mkTupleSort(personSort, personSort)
    var relationArity2 = tm.mkSetSort(tupleArity2)
    var emptySetTerm = tm.mkEmptySet(relationArity1)
    var emptyRelationTerm = tm.mkEmptySet(relationArity2)
    var universeSet = tm.mkUniverseSet(relationArity1)
    var people = tm.mkConst(relationArity1, "people")
    var males = tm.mkConst(relationArity1, "males")
    var females = tm.mkConst(relationArity1, "females")
    var father = tm.mkConst(relationArity2, "father")
    var mother = tm.mkConst(relationArity2, "mother")
    var parent = tm.mkConst(relationArity2, "parent")
    var ancestor = tm.mkConst(relationArity2, "ancestor")
    var descendant = tm.mkConst(relationArity2, "descendant")
    var isEmpty1 = tm.mkTerm(Kind.EQUAL, males, emptySetTerm)
    var isEmpty2 = tm.mkTerm(Kind.EQUAL, females, emptySetTerm)
    var peopleAreTheUniverse = tm.mkTerm(Kind.EQUAL, people, universeSet)
    var maleSetIsNotEmpty = tm.mkTerm(Kind.NOT, isEmpty1)
    var femaleSetIsNotEmpty = tm.mkTerm(Kind.NOT, isEmpty2)
    var malesFemalesIntersection = tm.mkTerm(Kind.SET_INTER, males, females)
    var malesAndFemalesAreDisjoint = tm.mkTerm(Kind.EQUAL, malesFemalesIntersection, emptySetTerm)
    var isEmpty3 = tm.mkTerm(Kind.EQUAL, father, emptyRelationTerm)
    var isEmpty4 = tm.mkTerm(Kind.EQUAL, mother, emptyRelationTerm)
    var fatherIsNotEmpty = tm.mkTerm(Kind.NOT, isEmpty3)
    var motherIsNotEmpty = tm.mkTerm(Kind.NOT, isEmpty4)
    var fathers = tm.mkTerm(Kind.RELATION_JOIN, father, people)
    var fathersAreMales = tm.mkTerm(Kind.SET_SUBSET, fathers, males)
    var mothers = tm.mkTerm(Kind.RELATION_JOIN, mother, people)
    var mothersAreFemales = tm.mkTerm(Kind.SET_SUBSET, mothers, females)
    var unionFatherMother = tm.mkTerm(Kind.SET_UNION, father, mother)
    var parentIsFatherOrMother = tm.mkTerm(Kind.EQUAL, parent, unionFatherMother)
    var transitiveClosure = tm.mkTerm(Kind.RELATION_TCLOSURE, parent)
    var ancestorFormula = tm.mkTerm(Kind.EQUAL, ancestor, transitiveClosure)
    var transpose = tm.mkTerm(Kind.RELATION_TRANSPOSE, ancestor)
    var descendantFormula = tm.mkTerm(Kind.EQUAL, descendant, transpose)
    var x = tm.mkVar(personSort, "x")
    var xxTuple = tm.mkTuple([x, x])
    var member = tm.mkTerm(Kind.SET_MEMBER, xxTuple, ancestor)
    var notMember = tm.mkTerm(Kind.NOT, member)
    var quantifiedVariables = tm.mkTerm(Kind.VARIABLE_LIST, x)
    var noSelfAncestor = tm.mkTerm(Kind.FORALL, quantifiedVariables, notMember)
    solver.assertFormula(peopleAreTheUniverse)
    solver.assertFormula(maleSetIsNotEmpty)
    solver.assertFormula(femaleSetIsNotEmpty)
    solver.assertFormula(malesAndFemalesAreDisjoint)
    solver.assertFormula(fatherIsNotEmpty)
    solver.assertFormula(motherIsNotEmpty)
    solver.assertFormula(fathersAreMales)
    solver.assertFormula(mothersAreFemales)
    solver.assertFormula(parentIsFatherOrMother)
    solver.assertFormula(descendantFormula)
    solver.assertFormula(ancestorFormula)
    solver.assertFormula(noSelfAncestor)
    var result = solver.checkSat()
    print(String("Result     = ", result))
    print(String("people     = ", solver.getValue(people)))
    print(String("males      = ", solver.getValue(males)))
    print(String("females    = ", solver.getValue(females)))
    print(String("father     = ", solver.getValue(father)))
    print(String("mother     = ", solver.getValue(mother)))
    print(String("parent     = ", solver.getValue(parent)))
    print(String("descendant = ", solver.getValue(descendant)))
    print(String("ancestor   = ", solver.getValue(ancestor)))
