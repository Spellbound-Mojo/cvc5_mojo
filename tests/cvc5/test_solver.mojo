    var boolVar = tm.mkVar(solver.getTermManager().getBooleanSort())
    var intVar = tm.mkVar(tm.getIntegerSort())
    _ = solver.mkGrammar([], [intVar])
    _ = solver.mkGrammar([boolVar], [intVar])
    var _raised1 = False
    try:
        _ = solver.mkGrammar([], [])
    except:
        _raised1 = True
    assert_true(_raised1, "expected an error")
    var _raised2 = False
    try:
        _ = solver.mkGrammar([], [boolTerm])
    except:
        _raised2 = True
    assert_true(_raised2, "expected an error")
    var _raised3 = False
