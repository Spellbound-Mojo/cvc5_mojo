def test_get_option_info() raises:
    var tm = TermManager()
    var solver = Solver(tm)
    var _raised1 = False
    try:
        _ = solver.getOptionInfo("asdf-invalid")
    except:
        _raised1 = True
    assert_true(_raised1, "expected an error")
    var info = solver.getOptionInfo("verbose")
    assert_true((info.name == "verbose"))
    assert_true((info.category == OptionCategory.COMMON))
    assert_true((info.aliases == []))
    assert_false(info.setByUser)
    assert_true(not Bool(info.type))
    info = solver.getOptionInfo("print-success")
    assert_true((info.name == "print-success"))
    assert_true((info.category == OptionCategory.COMMON))
    assert_true((info.aliases == []))
    assert_false(info.setByUser)
    assert_true((info.type.value() == "bool"))
    assert_true((Bool(info.current) and ((info.current.value().isa[Bool]() and (info.current.value()[Bool] == False)))))
    assert_true((Bool(info.default) and ((info.default.value().isa[Bool]() and (info.default.value()[Bool] == False)))))
    info = solver.getOptionInfo("verbosity")
    assert_true((info.name == "verbosity"))
    assert_true((info.category == OptionCategory.COMMON))
    assert_true((info.aliases == []))
    assert_false(info.setByUser)
    assert_true((info.type.value() == "int"))
    assert_true((Bool(info.current) and ((info.current.value().isa[Int]() and (info.current.value()[Int] == 0)) or (info.current.value().isa[UInt64]() and (info.current.value()[UInt64] == 0)))))
    assert_true((Bool(info.default) and ((info.default.value().isa[Int]() and (info.default.value()[Int] == 0)) or (info.default.value().isa[UInt64]() and (info.default.value()[UInt64] == 0)))))
    assert_true((not Bool(info.minimum) and not Bool(info.maximum)))
    info = solver.getOptionInfo("rlimit")
    assert_true((info.name == "rlimit"))
    assert_true((info.category == OptionCategory.COMMON))
    assert_true((info.aliases == []))
    assert_false(info.setByUser)
    assert_true((info.type.value() == "int"))
    assert_true((Bool(info.current) and ((info.current.value().isa[Int]() and (info.current.value()[Int] == 0)) or (info.current.value().isa[UInt64]() and (info.current.value()[UInt64] == 0)))))
    assert_true((Bool(info.default) and ((info.default.value().isa[Int]() and (info.default.value()[Int] == 0)) or (info.default.value().isa[UInt64]() and (info.default.value()[UInt64] == 0)))))
    assert_true((not Bool(info.minimum) and not Bool(info.maximum)))
    info = solver.getOptionInfo("random-freq")
    assert_true((info.name == "random-freq"))
    assert_true((info.category == OptionCategory.EXPERT))
    assert_true((info.aliases == ["random-frequency"]))
    assert_false(info.setByUser)
    assert_true((info.type.value() == "float"))
    assert_true((Bool(info.current) and ((info.current.value().isa[Float64]() and (info.current.value()[Float64] == 0.0)))))
    assert_true((Bool(info.default) and ((info.default.value().isa[Float64]() and (info.default.value()[Float64] == 0.0)))))
    assert_true(((Bool(info.minimum) and ((info.minimum.value().isa[Float64]() and (info.minimum.value()[Float64] == 0.0)))) and (Bool(info.maximum) and ((info.maximum.value().isa[Float64]() and (info.maximum.value()[Float64] == 1.0))))))
    info = solver.getOptionInfo("force-logic")
    assert_true((info.name == "force-logic"))
    assert_true((info.category == OptionCategory.COMMON))
    assert_true((info.aliases == []))
    assert_false(info.setByUser)
    assert_true((info.type.value() == "str"))
    assert_true((Bool(info.current) and ((info.current.value().isa[String]() and (info.current.value()[String] == "")))))
    assert_true((Bool(info.default) and ((info.default.value().isa[String]() and (info.default.value()[String] == "")))))
    info = solver.getOptionInfo("simplification")
    assert_true((info.name == "simplification"))
    assert_true((info.category == OptionCategory.REGULAR))
    assert_true((info.aliases == ["simplification-mode"]))
    assert_false(info.setByUser)
    assert_true((Bool(info.type) and (info.type.value() == "mode")))
    assert_true((Bool(info.current) and ((info.current.value().isa[String]() and (info.current.value()[String] == "batch")))))
    assert_true((Bool(info.default) and ((info.default.value().isa[String]() and (info.default.value()[String] == "batch")))))
    assert_true((info.modes == ["batch", "none"]))


