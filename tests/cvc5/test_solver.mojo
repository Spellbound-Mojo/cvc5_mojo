def test_find_synth() raises:
    var tm = TermManager()
    var solver = Solver(tm)
    solver.setOption("sygus", "true")
    var boolSort = solver.getTermManager().getBooleanSort()
    var start = tm.mkVar(boolSort)
    var g = solver.mkGrammar([], [start])
    var truen = tm.mkBoolean(True)
    var falsen = tm.mkBoolean(False)
    g.addRule(start, truen)
    g.addRule(start, falsen)
    var f = solver.synthFun("f", [], solver.getTermManager().getBooleanSort(), g)
    var t = solver.findSynth(FindSynthTarget.ENUM)
    assert_true((not t.isNull() and t.getSort().isBoolean()))


