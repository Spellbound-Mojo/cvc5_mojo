def test_simplify() raises:
    var tm = TermManager()
    var solver = Solver(tm)
    var bvSort = tm.mkBitVectorSort(32)
    var uSort = tm.mkUninterpretedSort("u")
    var funSort1 = tm.mkFunctionSort([bvSort, bvSort], bvSort)
    var funSort2 = tm.mkFunctionSort(uSort, tm.getIntegerSort())
    var consListSpec = tm.mkDatatypeDecl("list")
    var cons = tm.mkDatatypeConstructorDecl("cons")
    cons.addSelector("head", tm.getIntegerSort())
    cons.addSelectorSelf("tail")
    consListSpec.addConstructor(cons)
    var nil = tm.mkDatatypeConstructorDecl("nil")
    consListSpec.addConstructor(nil)
    var consListSort = tm.mkDatatypeSort(consListSpec)
    var x = tm.mkConst(bvSort, "x")
    _ = solver.simplify(x)
    var a = tm.mkConst(bvSort, "a")
    _ = solver.simplify(a)
    var b = tm.mkConst(bvSort, "b")
    _ = solver.simplify(b)
    var x_eq_x = tm.mkTerm(Kind.EQUAL, x, x)
    _ = solver.simplify(x_eq_x)
    assert_true((tm.mkTrue() != x_eq_x))
    assert_true((tm.mkTrue() == solver.simplify(x_eq_x)))
    var x_eq_b = tm.mkTerm(Kind.EQUAL, x, b)
    _ = solver.simplify(x_eq_b)
    assert_true((tm.mkTrue() != x_eq_b))
    assert_true((tm.mkTrue() != solver.simplify(x_eq_b)))
    var slv = Solver(tm)
    _ = slv.simplify(x)
    var i1 = tm.mkConst(tm.getIntegerSort(), "i1")
    _ = solver.simplify(i1)
    var i2 = tm.mkTerm(Kind.MULT, i1, tm.mkInteger("23"))
    _ = solver.simplify(i2)
    assert_true((i1 != i2))
    assert_true((i1 != solver.simplify(i2)))
    var i3 = tm.mkTerm(Kind.ADD, i1, tm.mkInteger(0))
    _ = solver.simplify(i3)
    assert_true((i1 != i3))
    assert_true((i1 == solver.simplify(i3)))
    var consList = consListSort.getDatatype()
    var dt1 = tm.mkTerm(Kind.APPLY_CONSTRUCTOR, consList.getConstructor("cons").getTerm(), tm.mkInteger(0), tm.mkTerm(Kind.APPLY_CONSTRUCTOR, consList.getConstructor("nil").getTerm()))
    _ = solver.simplify(dt1)
    var dt2 = tm.mkTerm(Kind.APPLY_SELECTOR, consList["cons"].getSelector("head").getTerm(), dt1)
    _ = solver.simplify(dt2)
    var b1 = tm.mkVar(bvSort, "b1")
    _ = solver.simplify(b1)
    var b2 = tm.mkVar(bvSort, "b1")
    _ = solver.simplify(b2)
    var b3 = tm.mkVar(uSort, "b3")
    _ = solver.simplify(b3)
    var v1 = tm.mkConst(bvSort, "v1")
    _ = solver.simplify(v1)
    var v2 = tm.mkConst(tm.getIntegerSort(), "v2")
    _ = solver.simplify(v2)
    var f1 = tm.mkConst(funSort1, "f1")
    _ = solver.simplify(f1)
    var f2 = tm.mkConst(funSort2, "f2")
    _ = solver.simplify(f2)
    solver.defineFunsRec([f1, f2], [[b1, b2], [b3]], [v1, v2])
    _ = solver.simplify(f1)
    _ = solver.simplify(f2)
    var ttm = TermManager()
    slv = Solver(ttm)
    var _raised1 = False
    try:
        _ = slv.simplify(x)
    except:
        _raised1 = True
    assert_true(_raised1, "expected an error")


def test_simplify_apply_subs() raises:
