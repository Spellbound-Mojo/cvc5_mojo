def test_get_unsat_core_and_proof() raises:
    var tm = TermManager()
    var solver = Solver(tm)
    solver.setOption("incremental", "true")
    solver.setOption("produce-unsat-cores", "true")
    solver.setOption("produce-proofs", "true")
    var uSort = solver.getTermManager().mkUninterpretedSort("u")
    var intSort = tm.getIntegerSort()
    var boolSort = solver.getTermManager().getBooleanSort()
    var uToIntSort = solver.getTermManager().mkFunctionSort(uSort, intSort)
    var intPredSort = solver.getTermManager().mkFunctionSort(intSort, boolSort)
    var x = solver.getTermManager().mkConst(uSort, "x")
    var y = solver.getTermManager().mkConst(uSort, "y")
    var f = solver.getTermManager().mkConst(uToIntSort, "f")
    var p = solver.getTermManager().mkConst(intPredSort, "p")
    var zero = solver.getTermManager().mkInteger(0)
    var one = solver.getTermManager().mkInteger(1)
    var f_x = solver.getTermManager().mkTerm(Kind.APPLY_UF, f, x)
    var f_y = solver.getTermManager().mkTerm(Kind.APPLY_UF, f, y)
    var summ = solver.getTermManager().mkTerm(Kind.ADD, f_x, f_y)
    var p_0 = solver.getTermManager().mkTerm(Kind.APPLY_UF, p, zero)
    var p_f_y = solver.getTermManager().mkTerm(Kind.APPLY_UF, p, f_y)
    solver.assertFormula(solver.getTermManager().mkTerm(Kind.GT, zero, f_x))
    solver.assertFormula(solver.getTermManager().mkTerm(Kind.GT, zero, f_y))
    solver.assertFormula(solver.getTermManager().mkTerm(Kind.GT, summ, one))
    solver.assertFormula(p_0)
    solver.assertFormula(p_f_y.notTerm())
    assert_true(solver.checkSat().isUnsat())
    var unsat_core = solver.getUnsatCore()
    _ = solver.getProof()
    _ = solver.getProof(ProofComponent.SAT)
    solver.resetAssertions()
    for t in unsat_core:
        solver.assertFormula(t)
    var res = solver.checkSat()
    assert_true(res.isUnsat())
    _ = solver.getProof()


def test_get_unsat_core_and_proof_to_string() raises:
    var tm = TermManager()
    var solver = Solver(tm)
    solver.setOption("produce-proofs", "true")
    var uSort = tm.mkUninterpretedSort("u")
    var intSort = tm.getIntegerSort()
    var boolSort = tm.getBooleanSort()
    var uToIntSort = tm.mkFunctionSort(uSort, intSort)
    var intPredSort = tm.mkFunctionSort(intSort, boolSort)
    var x = tm.mkConst(uSort, "x")
    var y = tm.mkConst(uSort, "y")
    var f = tm.mkConst(uToIntSort, "f")
    var p = tm.mkConst(intPredSort, "p")
    var zero = tm.mkInteger(0)
    var one = tm.mkInteger(1)
    var f_x = tm.mkTerm(Kind.APPLY_UF, f, x)
    var f_y = tm.mkTerm(Kind.APPLY_UF, f, y)
    var summ = tm.mkTerm(Kind.ADD, f_x, f_y)
    var p_0 = tm.mkTerm(Kind.APPLY_UF, p, zero)
    var p_f_y = tm.mkTerm(Kind.APPLY_UF, p, f_y)
    solver.assertFormula(tm.mkTerm(Kind.GT, zero, f_x))
    solver.assertFormula(tm.mkTerm(Kind.GT, zero, f_y))
    solver.assertFormula(tm.mkTerm(Kind.GT, summ, one))
    solver.assertFormula(p_0)
    solver.assertFormula(p_f_y.notTerm())
    assert_true(solver.checkSat().isUnsat())
    var proofs = solver.getProof()
    assert_true((len(proofs) > 0))
    var printedProof = solver.proofToString(proofs[0])
    assert_true((printedProof.count_codepoints() > 0))
    printedProof = solver.proofToString(proofs[0], ProofFormat.ALETHE)
    assert_true((printedProof.count_codepoints() > 0))
    proofs = solver.getProof(ProofComponent.SAT)
    printedProof = solver.proofToString(proofs[0], ProofFormat.NONE)
    assert_true((printedProof.count_codepoints() > 0))


def test_proof_to_string_assertion_names() raises:
    var tm = TermManager()
    var solver = Solver(tm)
    solver.setOption("produce-proofs", "true")
    var uSort = tm.mkUninterpretedSort("u")
    var x = tm.mkConst(uSort, "x")
    var y = tm.mkConst(uSort, "y")
    var x_eq_y = tm.mkTerm(Kind.EQUAL, x, y)
    var not_x_eq_y = tm.mkTerm(Kind.NOT, x_eq_y)
    var names = {x_eq_y: "as1", not_x_eq_y: "as2"}
    solver.assertFormula(x_eq_y)
    solver.assertFormula(not_x_eq_y)
    assert_true(solver.checkSat().isUnsat())
    var proofs = solver.getProof()
    assert_true((len(proofs) > 0))
    var printedProof = solver.proofToString(proofs[0], ProofFormat.ALETHE, names)
    assert_true((printedProof.count_codepoints() > 0))
    assert_true(("as1" in printedProof))
    assert_true(("as2" in printedProof))


