def test_get_value3() raises:
    var tm = TermManager()
    var solver = Solver(tm)
    solver.setOption("produce-models", "true")
    var uSort = tm.mkUninterpretedSort("u")
    var intSort = tm.getIntegerSort()
    var boolSort = tm.getBooleanSort()
    var uToIntSort = tm.mkFunctionSort(uSort, intSort)
    var intPredSort = tm.mkFunctionSort(intSort, boolSort)
    var x = tm.mkConst(uSort, "x")
    var y = tm.mkConst(uSort, "y")
    var z = tm.mkConst(uSort, "z")
    var f = tm.mkConst(uToIntSort, "f")
    var p = tm.mkConst(intPredSort, "p")
    var zero = tm.mkInteger(0)
    var one = tm.mkInteger(1)
    var f_x = tm.mkTerm(Kind.APPLY_UF, f, x)
    var f_y = tm.mkTerm(Kind.APPLY_UF, f, y)
    var summ = tm.mkTerm(Kind.ADD, f_x, f_y)
    var p_0 = tm.mkTerm(Kind.APPLY_UF, p, zero)
    var p_f_y = tm.mkTerm(Kind.APPLY_UF, p, f_y)
    solver.assertFormula(tm.mkTerm(Kind.LEQ, zero, f_x))
    solver.assertFormula(tm.mkTerm(Kind.LEQ, zero, f_y))
    solver.assertFormula(tm.mkTerm(Kind.LEQ, summ, one))
    solver.assertFormula(p_0.notTerm())
    solver.assertFormula(p_f_y)
    assert_true(solver.checkSat().isSat())
    solver.getValue(x)
    solver.getValue(y)
    solver.getValue(z)
    solver.getValue(summ)
    solver.getValue(p_f_y)
    var a: List[type_of(solver.getValue(x))] = [solver.getValue(x), solver.getValue(y), solver.getValue(z)]
    var b = solver.getValue([x, y, z])
    assert_true((a == b))
    var _raised1 = False
    try:
        Solver(tm).getValue(x)
    except:
        _raised1 = True
    assert_true(_raised1, "expected an error")
    var slv = Solver(tm)
    slv.setOption("produce-models", "true")
    _ = slv.checkSat()
    slv.getValue(x)
    var ttm = TermManager()
    slv = Solver(ttm)
    slv.setOption("produce-models", "true")
    _ = slv.checkSat()
    var _raised2 = False
    try:
        slv.getValue(tm.mkConst(tm.getBooleanSort(), "x"))
    except:
        _raised2 = True
    assert_true(_raised2, "expected an error")


def test_declare_sep_heap() raises:
    var tm = TermManager()
    var solver = Solver(tm)
    solver.setLogic("ALL")
    solver.setOption("incremental", "false")
    var integer = tm.getIntegerSort()
    solver.declareSepHeap(integer, integer)
    var _raised1 = False
    try:
        solver.declareSepHeap(integer, integer)
    except:
        _raised1 = True
    assert_true(_raised1, "expected an error")
    var _raised2 = False
    try:
        Solver(tm).declareSepHeap(tm.getIntegerSort(), tm.getIntegerSort())
    except:
        _raised2 = True
    assert_true(_raised2, "expected an error")
    var ttm = TermManager()
    var slv = Solver(ttm)
    slv.setLogic("ALL")
    var _raised3 = False
    try:
        slv.declareSepHeap(integer, ttm.getRealSort())
    except:
        _raised3 = True
    assert_true(_raised3, "expected an error")
    slv = Solver(ttm)
    slv.setLogic("ALL")
    var _raised4 = False
    try:
        slv.declareSepHeap(ttm.getBooleanSort(), integer)
    except:
        _raised4 = True
    assert_true(_raised4, "expected an error")


