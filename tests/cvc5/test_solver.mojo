def test_get_instantiations() raises:
    var tm = TermManager()
    var solver = Solver(tm)
    var iSort = tm.getIntegerSort()
    var boolSort = solver.getTermManager().getBooleanSort()
    var p = solver.declareFun("p", [iSort], boolSort)
    var x = tm.mkVar(iSort, "x")
    var bvl = tm.mkTerm(Kind.VARIABLE_LIST, x)
    var app = tm.mkTerm(Kind.APPLY_UF, p, x)
    var q = tm.mkTerm(Kind.FORALL, bvl, app)
    solver.assertFormula(q)
    var five = tm.mkInteger(5)
    var app2 = tm.mkTerm(Kind.NOT, tm.mkTerm(Kind.APPLY_UF, p, five))
    solver.assertFormula(app2)
    var _raised1 = False
    try:
        _ = solver.getInstantiations()
    except:
        _raised1 = True
    assert_true(_raised1, "expected an error")
    _ = solver.checkSat()
    _ = solver.getInstantiations()


def test_get_statistics() raises:
    var tm = TermManager()
    var solver = Solver(tm)
    var s1 = tm.getIntegerSort()
    var s2 = tm.mkArraySort(s1, s1)
    var t1 = tm.mkConst(s1, "i")
    var t2 = tm.mkVar(s2, "a")
    var t3 = tm.mkTerm(Kind.SELECT, t2, t1)
    _ = solver.checkSat()
    var stats = solver.getStatistics()
    assert_false(stats["global::totalTime"].internal)
    assert_false(stats["global::totalTime"].default)
    assert_true((_slice(stats["global::totalTime"].value[String], -2, Int.MAX) == "ms"))
    assert_true(stats["resource::resourceUnitsUsed"].internal)
    assert_false(stats["resource::resourceUnitsUsed"].default)
    assert_true(stats.get(True)["resource::resourceUnitsUsed"].internal)
    assert_false(stats.get(True)["resource::resourceUnitsUsed"].default)
    assert_true(not _contains_key_Statistics(stats, ""))
    assert_true((len(_collect_Statistics(stats)) > 0))
    for s in stats:
        _ = String(s)
        if (s[0] == "theory::arrays::avgIndexListLength"):
            assert_true(s[1].internal)
            assert_true(s[1].default)
            assert_true(isnan(s[1].value[Float64]))


