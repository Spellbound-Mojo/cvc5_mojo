    var pre = solver.declareFun("pre", [real], boolean)
    var trans = solver.declareFun("trans", [real, real], boolean)
    var post = solver.declareFun("post", [real], boolean)
    var inv1 = solver.declareFun("inv1", [real], real)
    var trans1 = solver.declareFun("trans1", [boolean, real], boolean)
    var trans2 = solver.declareFun("trans2", [real, boolean], boolean)
