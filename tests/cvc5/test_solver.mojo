def test_get_interpolant() raises:
    var tm = TermManager()
    var solver = Solver(tm)
    solver.setLogic("QF_LIA")
    solver.setOption("produce-interpolants", "true")
    solver.setOption("incremental", "false")
    var intSort = tm.getIntegerSort()
    var zero = tm.mkInteger(0)
    var x = tm.mkConst(intSort, "x")
    var y = tm.mkConst(intSort, "y")
    var z = tm.mkConst(intSort, "z")
    solver.assertFormula(tm.mkTerm(Kind.GT, tm.mkTerm(Kind.ADD, x, y), zero))
    solver.assertFormula(tm.mkTerm(Kind.LT, x, zero))
    var conj = tm.mkTerm(Kind.OR, tm.mkTerm(Kind.GT, tm.mkTerm(Kind.ADD, y, z), zero), tm.mkTerm(Kind.LT, z, zero))
    var output = solver.getInterpolant(conj)
    assert_true(output.getSort().isBoolean())
    var boolean = solver.getTermManager().getBooleanSort()
    var truen = tm.mkBoolean(True)
    var start = tm.mkVar(boolean)
    var g = solver.mkGrammar([], [start])
    var conj2 = tm.mkTerm(Kind.EQUAL, zero, zero)
    g.addRule(start, truen)
    var output2 = solver.getInterpolant(conj2, g)
    assert_true((output2 == truen))
    var ttm = TermManager()
    var slv = Solver(ttm)
    slv.setOption("produce-interpolants", "true")
    var intSort2 = ttm.getIntegerSort()
    var xx = ttm.mkConst(intSort2, "x")
    var yy = ttm.mkConst(intSort2, "y")
    var zzero = ttm.mkInteger(0)
    var sstart = ttm.mkVar(ttm.getBooleanSort())
    slv.assertFormula(ttm.mkTerm(Kind.GT, ttm.mkTerm(Kind.ADD, xx, yy), zzero))
    var gg = slv.mkGrammar([], [sstart])
    gg.addRule(sstart, ttm.mkTrue())
    var cconj2 = ttm.mkTerm(Kind.EQUAL, zzero, zzero)
    _ = slv.getInterpolant(cconj2, gg)
    var _raised1 = False
    try:
        _ = slv.getInterpolant(conj2)
    except:
        _raised1 = True
    assert_true(_raised1, "expected an error")
    var _raised2 = False
    try:
        _ = slv.getInterpolant(conj2, gg)
    except:
        _raised2 = True
    assert_true(_raised2, "expected an error")
    var _raised3 = False
    try:
        _ = slv.getInterpolant(cconj2, g)
    except:
        _raised3 = True
    assert_true(_raised3, "expected an error")


