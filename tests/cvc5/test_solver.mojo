def test_synth_fun() raises:
    var tm = TermManager()
    var solver = Solver(tm)
    solver.setOption("sygus", "true")
    var boolean = solver.getTermManager().getBooleanSort()
    var integer = tm.getIntegerSort()
    var x = tm.mkVar(boolean)
    var start1 = tm.mkVar(boolean)
    var start2 = tm.mkVar(integer)
    var g1 = solver.mkGrammar(_collect_Term(x), [start1])
    g1.addRule(start1, tm.mkBoolean(False))
    var g2 = solver.mkGrammar(_collect_Term(x), [start2])
    g2.addRule(start2, tm.mkInteger(0))
    _ = solver.synthFun("", [], boolean)
    _ = solver.synthFun("f1", [x], boolean)
    _ = solver.synthFun("f2", [x], boolean, g1)
    var _raised1 = False
    try:
        _ = solver.synthFun("f6", [x], boolean, g2)
    except:
        _raised1 = True
    assert_true(_raised1, "expected an error")
    var slv = Solver(tm)
    slv.setOption("sygus", "true")
    var x2 = tm.mkVar(tm.getBooleanSort())
    _ = slv.synthFun("f1", [x2], tm.getBooleanSort())
    _ = slv.synthFun("", [], tm.getBooleanSort())
    _ = slv.synthFun("f1", [x], tm.getBooleanSort())
    var ttm = TermManager()
    slv = Solver(ttm)
    slv.setOption("sygus", "true")
    _ = slv.checkSat()
    x2 = ttm.mkVar(ttm.getBooleanSort())
    var _raised2 = False
    try:
        _ = slv.synthFun("f1", [x2], tm.getBooleanSort())
    except:
        _raised2 = True
    assert_true(_raised2, "expected an error")
    var _raised3 = False
    try:
        _ = slv.synthFun("", [], tm.getBooleanSort())
    except:
        _raised3 = True
    assert_true(_raised3, "expected an error")
    var _raised4 = False
    try:
        _ = slv.synthFun("f1", [x], ttm.getBooleanSort())
    except:
        _raised4 = True
    assert_true(_raised4, "expected an error")


def test_tuple_project() raises:
    var tm = TermManager()
    var solver = Solver(tm)
    var elements: List[type_of(tm.mkBoolean(True))] = [tm.mkBoolean(True), tm.mkInteger(3), tm.mkString("C"), tm.mkTerm(Kind.SET_SINGLETON, tm.mkString("Z"))]
    var tuple = tm.mkTuple(elements)
    var indices1 = List[Int]()
    var indices2: List[type_of(0)] = [0]
    var indices3: List[type_of(0)] = [0, 1]
    var indices4: List[type_of(0)] = [0, 0, 2, 2, 3, 3, 0]
    var indices5: List[type_of(4)] = [4]
    var indices6: List[type_of(0)] = [0, 4]
    _ = tm.mkTerm(tm.mkOp(Kind.TUPLE_PROJECT, indices1), tuple)
    _ = tm.mkTerm(tm.mkOp(Kind.TUPLE_PROJECT, indices2), tuple)
    _ = tm.mkTerm(tm.mkOp(Kind.TUPLE_PROJECT, indices3), tuple)
    _ = tm.mkTerm(tm.mkOp(Kind.TUPLE_PROJECT, indices4), tuple)
    var _raised1 = False
    try:
        _ = tm.mkTerm(tm.mkOp(Kind.TUPLE_PROJECT, indices5), tuple)
    except:
        _raised1 = True
    assert_true(_raised1, "expected an error")
    var _raised2 = False
    try:
        _ = tm.mkTerm(tm.mkOp(Kind.TUPLE_PROJECT, indices6), tuple)
    except:
        _raised2 = True
    assert_true(_raised2, "expected an error")
    var indices: List[type_of(0)] = [0, 3, 2, 0, 1, 2]
    var op = tm.mkOp(Kind.TUPLE_PROJECT, indices)
    var projection = tm.mkTerm(op, tuple)
    var datatype = tuple.getSort().getDatatype()
    var constructor = datatype[0]
    for i in indices:
        var selectorTerm = constructor[i].getTerm()
        var selectedTerm = tm.mkTerm(Kind.APPLY_SELECTOR, selectorTerm, tuple)
        var simplifiedTerm = solver.simplify(selectedTerm)
        assert_true((elements[i] == simplifiedTerm))
        assert_true((String(projection) == "((_ tuple.project 0 3 2 0 1 2) (tuple true 3 \"C\" (set.singleton \"Z\")))"))


