def test_learned_literals2() raises:
    var tm = TermManager()
    var solver = Solver(tm)
    solver.setOption("produce-learned-literals", "true")
    var intSort = tm.getIntegerSort()
    var x = tm.mkConst(intSort, "x")
    var y = tm.mkConst(intSort, "y")
    var zero = tm.mkInteger(0)
    var ten = tm.mkInteger(10)
    var f0 = tm.mkTerm(Kind.GEQ, x, ten)
    var f1 = tm.mkTerm(Kind.OR, tm.mkTerm(Kind.GEQ, zero, x), tm.mkTerm(Kind.GEQ, y, zero))
    solver.assertFormula(f0)
    solver.assertFormula(f1)
    _ = solver.checkSat()
    _ = solver.getLearnedLiterals(LearnedLitType.INPUT)


def test_get_timeout_core_unsat() raises:
    var tm = TermManager()
    var solver = Solver(tm)
    solver.setOption("timeout-core-timeout", "100")
    solver.setOption("produce-unsat-cores", "true")
    var intSort = tm.getIntegerSort()
    var x = tm.mkConst(intSort, "x")
    var tt = tm.mkBoolean(True)
    var hard = tm.mkTerm(Kind.EQUAL, tm.mkTerm(Kind.MULT, x, x), tm.mkInteger("501240912901901249014210220059591"))
    solver.assertFormula(tt)
    solver.assertFormula(hard)
    var res = solver.getTimeoutCore()
    assert_true(res[0].isUnknown())
    assert_true((len(res[1]) == 1))
    assert_true((res[1][0] == hard))


