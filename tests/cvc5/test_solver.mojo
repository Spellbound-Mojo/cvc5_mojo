def _slice(value: String, start: Int, stop: Int) -> String:
    var size = value.count_codepoints()
    var first = max(0, size + start) if start < 0 else min(size, start)
    var last = max(0, size + stop) if stop < 0 else min(size, stop)
    var result = String()
    var index = 0
    for cp in value.codepoint_slices():
        if first <= index and index < last:
            result += String(cp)
        index += 1
    return result


def checkSimpleSeparationConstraints(slv: Solver) raises:
    var tm = slv.getTermManager()
    var integer = tm.getIntegerSort()
    slv.declareSepHeap(integer, integer)
    var x = tm.mkConst(integer, "x")
    var p = tm.mkConst(integer, "p")
    var heap = tm.mkTerm(Kind.SEP_PTO, p, x)
    slv.assertFormula(heap)
    var nil = tm.mkSepNil(integer)
    slv.assertFormula(nil.eqTerm(tm.mkInteger(5)))
    _ = slv.checkSat()


