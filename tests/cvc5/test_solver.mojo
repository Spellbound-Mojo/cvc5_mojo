def test_plugin_listen() raises:
    var tm = TermManager()
    var solver = Solver(tm)
    solver.setOption("sat-solver", "minisat")
    solver.setOption("plugin-notify-sat-clause-in-solve", "false")
    var pl = ArcPointer(PluginListen(tm))
    solver.addPlugin(pl)
    var stringSort = tm.getStringSort()
    var x = tm.mkConst(stringSort, "x")
    var y = tm.mkConst(stringSort, "y")
    var ctn1 = tm.mkTerm(Kind.STRING_CONTAINS, x, y)
    var ctn2 = tm.mkTerm(Kind.STRING_CONTAINS, y, x)
    solver.assertFormula(tm.mkTerm(Kind.OR, ctn1, ctn2))
    var lx = tm.mkTerm(Kind.STRING_LENGTH, x)
    var ly = tm.mkTerm(Kind.STRING_LENGTH, y)
    var lc = tm.mkTerm(Kind.GT, lx, ly)
    solver.assertFormula(lc)
    assert_true(solver.checkSat().isSat())
    assert_true(pl[].hasSeenTheoryLemma())
    assert_true(pl[].hasSeenSatClause())


