def test_is_model_core_symbol() raises:
    var tm = TermManager()
    var solver = Solver(tm)
    solver.setOption("produce-models", "true")
    solver.setOption("model-cores", "simple")
    var uSort = tm.mkUninterpretedSort("u")
    var x = tm.mkConst(uSort, "x")
    var y = tm.mkConst(uSort, "y")
    var z = tm.mkConst(uSort, "z")
    var zero = tm.mkInteger(0)
    var f = tm.mkTerm(Kind.NOT, tm.mkTerm(Kind.EQUAL, x, y))
    solver.assertFormula(f)
    _ = solver.checkSat()
    assert_true(solver.isModelCoreSymbol(x))
    assert_true(solver.isModelCoreSymbol(y))
    assert_false(solver.isModelCoreSymbol(z))
    var _raised1 = False
    try:
        _ = solver.isModelCoreSymbol(zero)
    except:
        _raised1 = True
    assert_true(_raised1, "expected an error")
    var ttm = TermManager()
    var slv = Solver(ttm)
    slv.setOption("produce-models", "true")
    _ = slv.checkSat()
    var _raised2 = False
    try:
        _ = slv.isModelCoreSymbol(tm.mkConst(uSort, "x"))
    except:
        _raised2 = True
    assert_true(_raised2, "expected an error")


