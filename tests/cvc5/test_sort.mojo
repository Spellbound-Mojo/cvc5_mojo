    assert_true((String(uninterp_sort) == name))
    assert_true((String(bvsort8) == "(_ BitVec 8)"))
    assert_true((String(uninterp_sort) == name))


def test_sort_substitute() raises:
    var tm = TermManager()
    var sortVar0 = tm.mkParamSort("T0")
    var sortVar1 = tm.mkParamSort("T1")
    var intSort = tm.getIntegerSort()
    var realSort = tm.getRealSort()
    var arraySort0 = tm.mkArraySort(sortVar0, sortVar0)
    var arraySort1 = tm.mkArraySort(sortVar0, sortVar1)
    _ = arraySort0.substitute(sortVar0, intSort)
    _ = arraySort1.substitute([sortVar0, sortVar1], [intSort, realSort])


