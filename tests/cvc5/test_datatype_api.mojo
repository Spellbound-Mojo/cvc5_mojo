def test_parametric_datatype() raises:
    var tm = TermManager()
    var v = List[Sort]()
    var t1 = tm.mkParamSort("T1")
    var t2 = tm.mkParamSort("T2")
    v.append(t1)
    v.append(t2)
    var pairSpec = tm.mkDatatypeDecl("pair", v)
    var mkpair = tm.mkDatatypeConstructorDecl("mk-pair")
    mkpair.addSelector("first", t1)
    mkpair.addSelector("second", t2)
    pairSpec.addConstructor(mkpair)
    var pairType = tm.mkDatatypeSort(pairSpec)
    assert_true(pairType.getDatatype().isParametric())
    var dparams = pairType.getDatatype().getParameters()
    assert_true(((dparams[0] == t1) and (dparams[1] == t2)))
    v.clear()
    v.append(tm.getIntegerSort())
    v.append(tm.getIntegerSort())
    var pairIntInt = pairType.instantiate(v)
    v.clear()
    v.append(tm.getRealSort())
    v.append(tm.getRealSort())
    var pairRealReal = pairType.instantiate(v)
    v.clear()
    v.append(tm.getRealSort())
    v.append(tm.getIntegerSort())
    var pairRealInt = pairType.instantiate(v)
    v.clear()
    v.append(tm.getIntegerSort())
    v.append(tm.getRealSort())
    var pairIntReal = pairType.instantiate(v)
    assert_true((pairIntInt != pairRealReal))
    assert_true((pairIntReal != pairRealReal))
    assert_true((pairRealInt != pairRealReal))
    assert_true((pairIntInt != pairIntReal))
    assert_true((pairIntInt != pairRealInt))
    assert_true((pairIntReal != pairRealInt))


