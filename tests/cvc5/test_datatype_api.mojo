    var args: List[type_of(x)] = [x]
    var urListX = unresList.instantiate(args)
    var pcons = tm.mkDatatypeConstructorDecl("pcons")
    pcons.addSelector("car", x)
    pcons.addSelector("cdr", urListX)
    plist.addConstructor(pcons)
    var nil5 = tm.mkDatatypeConstructorDecl("pnil")
    plist.addConstructor(nil5)
    var dtdecls: List[type_of(plist)] = [plist]
    var dtsorts = tm.mkDatatypeSorts(dtdecls)
    assert_true((len(dtsorts) == 1))
    var d = dtsorts[0].getDatatype()
    var nilc = d[0]
    var isort = tm.getIntegerSort()
    var iargs: List[type_of(isort)] = [isort]
    var listInt = dtsorts[0].instantiate(iargs)
    var testConsTerm = nilc.getInstantiatedTerm(listInt)
    assert_true((testConsTerm != nilc.getTerm()))
    var _raised1 = False
    try:
        _ = nilc.getInstantiatedTerm(isort)
    except:
        _raised1 = True
    assert_true(_raised1, "expected an error")


