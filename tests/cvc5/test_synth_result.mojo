    var solver = Solver(tm)
    solver.setOption("sygus", "true")
    var f = solver.synthFun("f", [], solver.getTermManager().getBooleanSort())
    var boolTerm = tm.mkBoolean(True)
    solver.addSygusConstraint(boolTerm)
    var res = solver.checkSynth()
    assert_false(res.isNull())
    assert_true(res.hasSolution())
    assert_false(res.hasNoSolution())
    assert_false(res.isUnknown())
