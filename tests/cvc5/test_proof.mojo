"""Unit tests `test_proof.py` of cvc5's Python API, translated to Mojo."""

from std.testing import assert_false, assert_true

from cvc5_mojo import Kind, Proof, ProofRule, Solver, TermManager


def create_proof(tm: TermManager, solver: Solver) raises -> Proof:
    solver.setOption("produce-proofs", "true")
    var uSort = tm.mkUninterpretedSort("u")
    var intSort = tm.getIntegerSort()
    var boolSort = tm.getBooleanSort()
    var uToIntSort = tm.mkFunctionSort(uSort, intSort)
    var intPredSort = tm.mkFunctionSort(intSort, boolSort)
    var x = tm.mkConst(uSort, "x")
    var y = tm.mkConst(uSort, "y")
    var f = tm.mkConst(uToIntSort, "f")
    var p = tm.mkConst(intPredSort, "p")
    var zero = tm.mkInteger(0)
    var one = tm.mkInteger(1)
    var f_x = tm.mkTerm(Kind.APPLY_UF, f, x)
    var f_y = tm.mkTerm(Kind.APPLY_UF, f, y)
    var summ = tm.mkTerm(Kind.ADD, f_x, f_y)
    var p_0 = tm.mkTerm(Kind.APPLY_UF, p, zero)
    var p_f_y = tm.mkTerm(Kind.APPLY_UF, p, f_y)
    solver.assertFormula(tm.mkTerm(Kind.GT, zero, f_x))
    solver.assertFormula(tm.mkTerm(Kind.GT, zero, f_y))
    solver.assertFormula(tm.mkTerm(Kind.GT, summ, one))
    solver.assertFormula(p_0)
    solver.assertFormula(p_f_y.notTerm())
    assert_true(solver.checkSat().isUnsat())
    return solver.getProof()[0]


def create_rewrite_proof(tm: TermManager, solver: Solver) raises -> Proof:
    solver.setOption("produce-proofs", "true")
    solver.setOption("proof-granularity", "dsl-rewrite")
    var int_sort = tm.getIntegerSort()
    var x = tm.mkConst(int_sort, "x")
    var zero = tm.mkInteger(0)
    var geq = tm.mkTerm(Kind.GEQ, x, zero)
    var leq = tm.mkTerm(Kind.LEQ, zero, x)
    solver.assertFormula(tm.mkTerm(Kind.DISTINCT, geq, leq))
    _ = solver.checkSat()
    return solver.getProof()[0]


def test_null_proof() raises:
    var tm = TermManager()
    var solver = Solver(tm)
    var proof = Proof()
    assert_true((proof.getRule() == ProofRule.UNKNOWN))
    assert_true((hash(ProofRule.UNKNOWN) == hash(ProofRule.UNKNOWN)))
    assert_true(proof.getResult().isNull())
    assert_true((len(proof.getChildren()) == 0))
    assert_true((len(proof.getArguments()) == 0))


def test_get_rule() raises:
    var tm = TermManager()
    var solver = Solver(tm)
    var proof = create_proof(tm, solver)
    var rule = proof.getRule()
    assert_true((rule == ProofRule.SCOPE))


def test_get_rewrite_rule() raises:
    var tm = TermManager()
    var solver = Solver(tm)
    var proof = create_rewrite_proof(tm, solver)
    var _raised1 = False
    try:
        _ = proof.getRewriteRule()
    except:
        _raised1 = True
    assert_true(_raised1, "expected an error")
    var rule: Optional[ProofRule] = None
    var stack: List[type_of(proof)] = [proof]
    while (rule != ProofRule.DSL_REWRITE):
        proof = stack.pop()
        rule = proof.getRule()
        var children = proof.getChildren()
        stack.extend(children.copy())
    _ = proof.getRewriteRule()  # a `ProofRewriteRule` is never None


