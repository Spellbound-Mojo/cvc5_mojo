def test_eq() raises:
    var tm = TermManager()
    var solver = Solver(tm)
    var x = create_proof(tm, solver)
    var y = x.getChildren()[0]
    var z = Proof()
    assert_true((x == x))
    assert_false((x != x))
    assert_false((x == y))
    assert_true((x != y))
    assert_false((x == z))
    assert_true((x != z))
    assert_true((hash(x) == hash(x)))


